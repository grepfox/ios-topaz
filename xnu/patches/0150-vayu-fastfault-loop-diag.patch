From b7ae54de883639b043b89586b13e03c4f5bd6b4b Mon Sep 17 00:00:00 2001
From: grep <noreply@anthropic.com>
Date: Wed, 21 Oct 2026 19:12:25 +0200
Subject: [PATCH] vayu-0150: diagnose the arm_fast_fault loop (TTBR0/PTE/AT
 probe, full TLB flush)

0149 showed SPAN=1 (SCTLR 0x34d4593d) and PAN cleared, yet copyout from
load_init_program_at_path still faults forever: arm_fast_fault finds the
user PTE already RW+AF and reports success, the hardware faults again.
After 200/400/5000 repeats on the same page log FAR, ESR, TTBR0_EL1 vs
the pmap's ttep/ASID, the PTE and an AT S1E1W probe; at 400 do a full
TLBI VMALLE1IS to separate a stale TLB entry from a wrong TTBR0.
---
 osfmk/arm/pmap/pmap.c | 42 ++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 42 insertions(+)

diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
index 00568d3..8a9f491 100644
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -8357,6 +8357,48 @@ arm_fast_fault(
 #endif
 	} while (result == KERN_ABORTED);
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * vayu bring-up: the hardware kept faulting on a user page the pmap
+	 * already maps RW+AF ("sufficient permissions" -> KERN_SUCCESS -> the
+	 * same store faults again, forever: load_init_program copyout, dyld's
+	 * vm_allocate copyout). Count repeats of the same page; dump what the
+	 * MMU sees (TTBR0 vs this pmap, PTE, AT S1E1W), then flush the whole
+	 * TLB to tell a stale TLB entry from a wrong translation table.
+	 */
+	if (result == KERN_SUCCESS) {
+		static vm_map_address_t loop_va;
+		static pmap_t loop_pmap;
+		static uint32_t loop_n;
+		vm_map_address_t pva = va & ~(vm_map_address_t)0x3fff;
+		if (pva == loop_va && pmap == loop_pmap) {
+			loop_n++;
+		} else {
+			loop_va = pva;
+			loop_pmap = pmap;
+			loop_n = 0;
+		}
+		if (loop_n == 200 || loop_n == 400 || loop_n == 5000) {
+			pt_entry_t *ptep = pmap_pte(pmap, pva);
+			uint64_t par;
+			__asm__ volatile ("at s1e1w, %0; isb" :: "r"(va) : "memory");
+			par = __builtin_arm_rsr64("PAR_EL1");
+			printf("SWEET FASTFAULT loop %u: va 0x%llx type 0x%x af %d user %d FAR 0x%llx ESR 0x%llx "
+			    "TTBR0 0x%llx pmap ttep 0x%llx asid %u/%u PTE 0x%llx PAR(s1e1w) 0x%llx CPSR 0x%llx cpu %d\n",
+			    loop_n, (unsigned long long)va, fault_type, was_af_fault, from_user,
+			    __builtin_arm_rsr64("FAR_EL1"), __builtin_arm_rsr64("ESR_EL1"),
+			    __builtin_arm_rsr64("TTBR0_EL1"), (unsigned long long)pmap->ttep,
+			    pmap->hw_asid, pmap->sw_asid,
+			    ptep ? (unsigned long long)*ptep : 0ull, par, __builtin_arm_rsr64("SPSR_EL1"),
+			    cpu_number());
+		}
+		if (loop_n == 400) {
+			__asm__ volatile ("dsb ishst; tlbi vmalle1is; dsb ish; isb" ::: "memory");
+			printf("SWEET FASTFAULT: full TLB flush (tlbi vmalle1is) at loop 400\n");
+		}
+	}
+#endif
+
 	PMAP_TRACE(3, PMAP_CODE(PMAP__FAST_FAULT) | DBG_FUNC_END, result);
 
 	return result;
-- 
