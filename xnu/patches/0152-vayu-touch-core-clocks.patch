From 1f75d466fc31451065ae490ea71d5a2214686da2 Mon Sep 17 00:00:00 2001
From: grep <noreply@anthropic.com>
Date: Wed, 21 Oct 2026 20:34:08 +0200
Subject: [PATCH] vayu-0152: touch: vote the QUPv3 wrap2 core clocks; firmware
 fallback

0151 log: panel 42 (CSOT) -> fw02, SE17 SPI firmware present (proto 1),
clocks on, but every SPI command stayed ACTIVE (GENI status 0x41, no
M_CMD_DONE): no sequencer clock. Vote BIT0/BIT3 of 0x52014 (wrap2 core
and core_2x) as well; log GENI_IF_DISABLE; if the panel's firmware does
not start, try the other one.
---
 bsd/dev/vayu_touch.c | 32 ++++++++++++++++++++++----------
 1 file changed, 22 insertions(+), 10 deletions(-)

diff --git a/bsd/dev/vayu_touch.c b/bsd/dev/vayu_touch.c
index 20e29fd..73eaffd 100644
--- a/bsd/dev/vayu_touch.c
+++ b/bsd/dev/vayu_touch.c
@@ -36,8 +36,14 @@ void vayu_touch_init(void);
 /* GCC (gcc-sm8150.c): QUPv3 wrap2 S0 (= SE17) branch, its RCG, wrap2 AHB votes */
 #define VT_GCC_PA        0x00100000u
 #define VT_GCC_SIZE      0x00060000u
-#define VT_GCC_VOTE      0x52014u        /* BIT1 wrap2 s_ahb, BIT2 m_ahb, BIT4 wrap2 s0 */
-#define VT_GCC_VOTE_BITS 0x16u
+/*
+ * BIT1 wrap2 s_ahb, BIT2 m_ahb, BIT4 wrap2 s0 (gcc-sm8150.c); BIT0/BIT3 are
+ * the wrapper core / core_2x clocks (mainline GCC_QUPV3_WRAP2_CORE(_2X)),
+ * absent from the vayu kernel's gcc driver. 0151 voted only 0x16: register
+ * access worked but every command stayed ACTIVE (status 0x41), no clock.
+ */
+#define VT_GCC_VOTE      0x52014u
+#define VT_GCC_VOTE_BITS 0x1fu
 #define VT_GCC_S0_CBCR   0x1e144u
 #define VT_GCC_S0_RCG    0x1e148u        /* CMD; CFG +4 */
 
@@ -207,8 +213,8 @@ vt_se_init(void)
 	uint32_t fw = vt_rd(vt.se, SE_FW), tx = vt_rd(vt.se, SE_HW_TX), rx = vt_rd(vt.se, SE_HW_RX);
 	vt.tx_depth = (tx >> 16) & 0x3fu;
 	vt.rx_depth = (rx >> 16) & 0x3fu;
-	printf("VAYU TOUCH: se17 fw %#x proto %u status %#x tx %#x rx %#x\n",
-	    fw, (fw >> 8) & 0xffu, vt_rd(vt.se, SE_STATUS), tx, rx);
+	printf("VAYU TOUCH: se17 fw %#x proto %u status %#x if_disable %#x tx %#x rx %#x\n",
+	    fw, (fw >> 8) & 0xffu, vt_rd(vt.se, SE_STATUS), vt_rd(vt.se, 0x064), tx, rx);
 	if (((fw >> 8) & 0xffu) != 1u || vt.tx_depth < 2 || vt.rx_depth < 2 ||
 	    ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u) {
 		printf("VAYU TOUCH: SE17 has no SPI firmware or 32-bit FIFOs; stopping\n");
@@ -601,8 +607,9 @@ vt_report(uint32_t mask, const int *x, const int *y)
 	vt.active = mask;
 }
 
+/* which = 0: the panel's firmware, 1: the other one (fallback) */
 static const uint8_t *
-vt_firmware(uint32_t *size, const char **name)
+vt_firmware(int which, uint32_t *size, const char **name)
 {
 	int panel = 0;
 	(void)PE_parse_boot_argn("vayupanel", &panel, sizeof(panel));
@@ -614,12 +621,13 @@ vt_firmware(uint32_t *size, const char **name)
 		return NULL;
 	}
 	/* nvt_cmds_panel_info: dsi_j20s_36_02_0a (Tianma) -> fw01, else fw02 */
-	*name = panel == 42 ? "fw02" : "fw01";
+	bool csot = panel == 42;
+	*name = (csot != (which != 0)) ? "fw02" : "fw01";
 	if (SecureDTGetProperty(e, *name, &p, &sz) != kSuccess || sz < 0x100) {
 		printf("VAYU TOUCH: ADT /vayu-touch has no %s\n", *name);
 		return NULL;
 	}
-	printf("VAYU TOUCH: panel %d -> %s (%u bytes)\n", panel, *name, sz);
+	printf("VAYU TOUCH: panel %d -> %s (%u bytes)%s\n", panel, *name, sz, which ? " (fallback)" : "");
 	*size = sz;
 	return (const uint8_t *)p;
 }
@@ -629,7 +637,7 @@ vt_thread(void *arg __unused, wait_result_t wr __unused)
 {
 	uint32_t fwsize = 0;
 	const char *fwname = "?";
-	const uint8_t *fw = vt_firmware(&fwsize, &fwname);
+	const uint8_t *fw = vt_firmware(0, &fwsize, &fwname);
 	if (fw == NULL) {
 		return;
 	}
@@ -666,8 +674,12 @@ vt_thread(void *arg __unused, wait_result_t wr __unused)
 		return;
 	}
 	if (nvt_download(fw, fwsize) != 0) {
-		printf("VAYU TOUCH: firmware %s did not start; stopping\n", fwname);
-		return;
+		printf("VAYU TOUCH: firmware %s did not start; trying the other one\n", fwname);
+		fw = vt_firmware(1, &fwsize, &fwname);
+		if (fw == NULL || nvt_download(fw, fwsize) != 0) {
+			printf("VAYU TOUCH: firmware %s did not start either; stopping\n", fwname);
+			return;
+		}
 	}
 	/* fw info (nvt_get_fw_info) and park the page on the event buffer */
 	uint8_t info[18] = { EV_FWINFO };
-- 
2.53.0

