From 75e859d85e3e1d47855a7fc2b8ed3def3105b92e Mon Sep 17 00:00:00 2001
From: grep <grepfox@tutamail.com>
Date: Thu, 22 Oct 2026 09:02:31 +0200
Subject: [PATCH] vayu-0161: touch GPI SMMU bypass by default, Linux SE GSI irq
 enables, stuck-transfer dump and GPII teardown

---
 bsd/dev/vayu_touch.c | 58 +++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 55 insertions(+), 3 deletions(-)

diff --git a/bsd/dev/vayu_touch.c b/bsd/dev/vayu_touch.c
index 7bd7388..efaf23b 100644
--- a/bsd/dev/vayu_touch.c
+++ b/bsd/dev/vayu_touch.c
@@ -500,7 +500,8 @@ vt_smmu_identity(uint32_t sid)
 	 * may not reach memory at all). Tells whether the reset at the first
 	 * GPI command comes from its memory accesses.
 	 */
-	int mode = 0;
+	/* 0160: bypass is the only mode where the GPI commands complete (CB8 identity and fault reset) */
+	int mode = 1;
 	(void)PE_parse_boot_argn("vayugpismmu", &mode, sizeof(mode));
 	printf("VAYU TOUCH: SMMU before: sGFSR %#x sCR0 %#x mode %d\n", vt_rd(s, 0x48), vt_rd(s, 0x0), mode);
 	if (mode == 1 || mode == 2) {
@@ -617,8 +618,9 @@ vg_init(void)
 	sweet_log_flush_now();
 	/* SE17 to GSI mode (geni_se_select_gsi_mode) */
 	vt_wr(vt.se, SE_IRQ_EN_REG, 0);
-	vt_wr(vt.se, SE_M_IRQ_EN, 0);
-	vt_wr(vt.se, SE_S_IRQ_EN, 0);
+	/* M/S_COMMON_GENI_*_IRQ_EN without CMD_DONE and the FIFO watermarks */
+	vt_wr(vt.se, SE_M_IRQ_EN, 0x33c0007eu);
+	vt_wr(vt.se, SE_S_IRQ_EN, 0x03003e3eu);
 	vt_wr(vt.se, SE_M_IRQ_CLR, 0xffffffffu);
 	vt_wr(vt.se, SE_S_IRQ_CLR, 0xffffffffu);
 	vt_wr(vt.se, SE_DMA_TX_CLR, 0xffffffffu);
@@ -761,6 +763,54 @@ vg_init(void)
 	return true;
 }
 
+/* State after a stuck transfer: SE side, GPII interrupt status, channel 0 context */
+static void
+vg_dump(void)
+{
+	uint32_t b = 0x4000u * VT_GPII;
+	printf("VAYU TOUCH: SE geni_status %#x m_cmd0 %#x m_irq %#x/%#x s_irq %#x/%#x dma_tx %#x dma_rx %#x dma_mode %#x gsi_ev %#x\n",
+	    vt_rd(vt.se, 0x040), vt_rd(vt.se, 0x600), vt_rd(vt.se, 0x610), vt_rd(vt.se, 0x614),
+	    vt_rd(vt.se, 0x640), vt_rd(vt.se, 0x644), vt_rd(vt.se, 0xc40), vt_rd(vt.se, 0xd40),
+	    vt_rd(vt.se, SE_DMA_MODE), vt_rd(vt.se, SE_GSI_EVENT_EN));
+	printf("VAYU TOUCH: GPII%u irq type %#x ch %#x ev %#x ieob %#x glob %#x gpii %#x\n", VT_GPII,
+	    vt_rd(vg.gpi, 0x23080u + b), vt_rd(vg.gpi, 0x23090u + b), vt_rd(vg.gpi, 0x23094u + b),
+	    vt_rd(vg.gpi, 0x230b0u + b), vt_rd(vg.gpi, 0x23100u + b), vt_rd(vg.gpi, 0x23118u + b));
+	for (unsigned k = 0; k < 2; k++) {
+		uint32_t c = GPI_CH_CTX(k);
+		printf("VAYU TOUCH: ch%u ctx %08x %08x %08x %08x %08x %08x %08x %08x scr0 %08x\n", k,
+		    vt_rd(vg.gpi, c), vt_rd(vg.gpi, c + 4), vt_rd(vg.gpi, c + 8), vt_rd(vg.gpi, c + 12),
+		    vt_rd(vg.gpi, c + 16), vt_rd(vg.gpi, c + 20), vt_rd(vg.gpi, c + 24), vt_rd(vg.gpi, c + 28),
+		    vt_rd(vg.gpi, GPI_CH_SCR(k, 0)));
+	}
+	sweet_log_flush_now();
+}
+
+/* Give the GPII back (stop, reset, de-allocate) and the SE back to FIFO/idle */
+static void
+vg_teardown(void)
+{
+	for (unsigned k = 0; k < 2; k++) {
+		unsigned st = vg_state(GPI_CH_CTX(k));
+		if (st == 2 || st == 5) {
+			(void)vg_cmd(k, GPI_CMD_STOP, 3);
+		}
+		if (vg_state(GPI_CH_CTX(k)) != 0) {
+			(void)vg_cmd(k, GPI_CMD_RESET, 1);
+			(void)vg_cmd(k, GPI_CMD_DEALLOC, 0);
+		}
+	}
+	if (vg_state(GPI_EV_CTX) != 0) {
+		(void)vg_cmd(2, GPI_CMD_RESET, 1);
+		(void)vg_cmd(2, GPI_CMD_DEALLOC, 0);
+	}
+	vt_wr(vt.se, SE_GSI_EVENT_EN, 0);
+	vt_wr(vt.se, SE_DMA_MODE, vt_rd(vt.se, SE_DMA_MODE) & ~1u);
+	vg.on = false;
+	printf("VAYU TOUCH: GPI torn down (ev %u ch0 %u ch1 %u)\n",
+	    vg_state(GPI_EV_CTX), vg_state(GPI_CH_CTX(0)), vg_state(GPI_CH_CTX(1)));
+	sweet_log_flush_now();
+}
+
 /* One SPI transfer through GPI: [CONFIG0] GO DMA(tx) on ch0, DMA(rx) on ch1 */
 static int
 vg_spi(const uint8_t *tx, uint8_t *rx, unsigned len)
@@ -842,6 +892,8 @@ vg_spi(const uint8_t *tx, uint8_t *rx, unsigned len)
 		    vg_state(GPI_CH_CTX(0)), vt_rd(vg.gpi, GPI_CH_CTX(0) + CTX_RP_LO), vt_rd(vg.gpi, GPI_CH_CTX(0) + CTX_WP_LO),
 		    vg_state(GPI_CH_CTX(1)), vt_rd(vg.gpi, GPI_CH_CTX(1) + CTX_RP_LO), vt_rd(vg.gpi, GPI_CH_CTX(1) + CTX_WP_LO),
 		    vt_rd(vg.gpi, GPI_EV_CTX + CTX_RP_LO), vt_rd(vg.gpi, GPI_ERR_LOG), vt_rd(vt.se, SE_STATUS));
+		vg_dump();
+		vg_teardown();
 		vt.dead = true;
 		return ETIMEDOUT;
 	}
-- 
