From fb2acd2e2fcf9fdecfc9b1f859f3c08ba9c8644e Mon Sep 17 00:00:00 2001
From: grep <grepfox@tutamail.com>
Date: Thu, 22 Oct 2026 14:14:48 +0200
Subject: [PATCH] vayu-0174: load-based CPU governor (20 ms, x1.25 headroom,
 touch boost 250 ms, lowest clocks with the display off; sweetgov=0 keeps max)

---
 bsd/dev/vayu_touch.c                  |   2 +
 iokit/Kernel/arm/SweetFramebuffer.cpp |   4 +
 osfmk/kern/exception.c                | 129 ++++++++++++++++++++++++++
 3 files changed, 135 insertions(+)

diff --git a/bsd/dev/vayu_touch.c b/bsd/dev/vayu_touch.c
index 74ab9ff..94bba18 100644
--- a/bsd/dev/vayu_touch.c
+++ b/bsd/dev/vayu_touch.c
@@ -44,6 +44,7 @@ extern void sweet_log_flush_now(void);   /* bsd/dev/sweet_ufs.c */
 extern void sweet_hid_touch(int finger, int down, int x, int y);
 void vayu_touch_init(void);
 extern void sweet_speed_start(void);
+extern void sweet_gov_touch(void);       /* osfmk/kern/exception.c */
 
 /* GCC (gcc-sm8150.c): QUPv3 wrap2 S0 (= SE17) branch, its RCG, wrap2 AHB votes */
 #define VT_GCC_PA        0x00100000u
@@ -1317,6 +1318,7 @@ vt_report(uint32_t mask, const int *x, const int *y)
 		if (mask & bit) {
 			if (!(vt.active & bit) || x[id] != vt.x[id] || y[id] != vt.y[id]) {
 				sweet_hid_touch((int)id, 1, x[id], y[id]);
+				sweet_gov_touch();
 				if (!(vt.active & bit)) {
 					vt.downs++;
 				}
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index ca707d4..765075b 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -75,6 +75,7 @@ extern "C" void sweet_dcache_clean(vm_offset_t addr, unsigned length);  /* osfmk
 extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
 extern "C" int sweet_soc_vayu(void);       /* osfmk/arm64/sweet_early.c */
 extern "C" int sweet_spmi_init(void);      /* bsd/dev/sweet_spmi.c */
+extern "C" void sweet_gov_screen(int on);  /* osfmk/kern/exception.c */
 extern "C" int sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
 extern "C" int sweet_spmi_write(unsigned sid, unsigned addr, uint8_t val);
 
@@ -1316,6 +1317,9 @@ IOMobileFramebufferUserClient::externalMethod(uint32_t selector, IOExternalMetho
 					fFB->setPanelLevel(level);
 				}
 			}
+			if (changed && sweet_soc_vayu()) {
+				sweet_gov_screen(off ? 0 : 1);    /* lowest CPU clocks while off */
+			}
 			IOLog("SWEET FB: display %s\n", off ? "off" : "on");
 		}
 		break;
diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index 0001d9f..659fbaa 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -1229,6 +1229,8 @@ sweet_speed_thread(__unused void *arg, __unused wait_result_t wr)
 	sweet_speed_report(1);
 }
 
+static void sweet_gov_thread(void *arg, wait_result_t wr);
+static int gov_on;
 void sweet_speed_start(void);
 void
 sweet_speed_start(void)
@@ -1239,6 +1241,133 @@ sweet_speed_start(void)
 	if (on && kernel_thread_start(sweet_speed_thread, NULL, &t) == KERN_SUCCESS) {
 		thread_deallocate(t);
 	}
+	gov_on = 1;
+	(void)PE_parse_boot_argn("sweetgov", &gov_on, sizeof(gov_on));
+	if (gov_on && kernel_thread_start(sweet_gov_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+}
+
+/*
+ * SWEET vayu CPU governor (schedutil-like, sweetgov=0 keeps the shim's max).
+ * Every 20 ms: per cluster load = busiest CPU (recount idle time); target =
+ * 1.25 * load * fmax; lowest LUT row >= target. Up at once, down after 3
+ * quiet samples. Touch (sweet_gov_touch) holds max for 250 ms; display off
+ * (sweet_gov_screen) uses the lowest row. Clusters: cpu0-3 silver, 4-6
+ * gold, 7 prime (SWEET SPEED measured that order).
+ */
+#define GOV_PERIOD_MS 20
+static struct {
+	vm_offset_t b;
+	uint32_t nrow, khz[40], cur, quiet;
+} gov_dom[3];
+static uint64_t gov_boost_until;
+static int gov_screen_off;
+
+void sweet_gov_touch(void);
+void
+sweet_gov_touch(void)
+{
+	uint64_t t;
+	nanoseconds_to_absolutetime(250 * NSEC_PER_MSEC, &t);
+	__atomic_store_n(&gov_boost_until, mach_absolute_time() + t, __ATOMIC_RELAXED);
+}
+
+void sweet_gov_screen(int on);
+void
+sweet_gov_screen(int on)
+{
+	__atomic_store_n(&gov_screen_off, on ? 0 : 1, __ATOMIC_RELAXED);
+}
+
+static void
+sweet_gov_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static const uint32_t dom[3] = { 0x18323000u, 0x18325800u, 0x18327800u };
+	for (unsigned d = 0; d < 3; d++) {
+		gov_dom[d].b = ml_io_map(dom[d], 0x1000);
+		if (!gov_dom[d].b) {
+			printf("SWEET GOV: map failed; off\n");
+			return;
+		}
+		uint32_t prev = 0;
+		for (uint32_t i = 0; i < 40; i++) {
+			uint32_t v = *(volatile uint32_t *)(gov_dom[d].b + 0x110 + 0x20 * i);
+			uint32_t khz = ((v >> 30) & 3) ? 19200 * (v & 0xff) : 300000;
+			if (i && khz == prev) {
+				break;
+			}
+			gov_dom[d].khz[i] = khz;
+			gov_dom[d].nrow = i + 1;
+			prev = khz;
+		}
+		gov_dom[d].cur = *(volatile uint32_t *)(gov_dom[d].b + 0x920);
+		printf("SWEET GOV: domain %u: %u rows %u..%u MHz, now row %u\n", d, gov_dom[d].nrow,
+		    gov_dom[d].khz[0] / 1000, gov_dom[d].khz[gov_dom[d].nrow - 1] / 1000, gov_dom[d].cur);
+	}
+	unsigned n = ml_get_cpu_count();
+	if (n > 8) {
+		n = 8;
+	}
+	uint64_t last_idle[8] = {}, last_t = mach_absolute_time(), last_log = last_t, log_ns;
+	for (unsigned c = 0; c < n; c++) {
+		struct recount_usage u = {};
+		processor_t p = cpu_to_processor((int)c);
+		if (p != PROCESSOR_NULL) {
+			recount_processor_usage(&p->pr_recount, &u, &last_idle[c]);
+		}
+	}
+	unsigned logs = 0;
+	for (;;) {
+		delay_for_interval(GOV_PERIOD_MS, NSEC_PER_MSEC);
+		uint64_t now = mach_absolute_time(), dt = now - last_t;
+		last_t = now;
+		uint32_t load[3] = {0, 0, 0};       /* permille */
+		for (unsigned c = 0; c < n; c++) {
+			struct recount_usage u = {};
+			uint64_t idle = 0;
+			processor_t p = cpu_to_processor((int)c);
+			if (p == PROCESSOR_NULL) {
+				continue;
+			}
+			recount_processor_usage(&p->pr_recount, &u, &idle);
+			uint64_t di = idle - last_idle[c];
+			last_idle[c] = idle;
+			uint32_t busy = dt && di < dt ? (uint32_t)(1000 - (di * 1000) / dt) : 0;
+			unsigned d = c < 4 ? 0 : c < 7 ? 1 : 2;
+			if (busy > load[d]) {
+				load[d] = busy;
+			}
+		}
+		bool boost = now < __atomic_load_n(&gov_boost_until, __ATOMIC_RELAXED);
+		bool off = __atomic_load_n(&gov_screen_off, __ATOMIC_RELAXED) != 0;
+		for (unsigned d = 0; d < 3; d++) {
+			uint32_t top = gov_dom[d].nrow - 1, row = top;
+			if (off && !boost) {
+				row = 0;
+			} else if (!boost) {
+				uint64_t want = ((uint64_t)gov_dom[d].khz[top] * load[d]) / 800u;   /* x1.25 */
+				for (row = 0; row < top && gov_dom[d].khz[row] < want; row++) {
+				}
+			}
+			if (row < gov_dom[d].cur && ++gov_dom[d].quiet < 3) {
+				continue;                    /* go down only after 3 quiet samples */
+			}
+			gov_dom[d].quiet = 0;
+			if (row != gov_dom[d].cur) {
+				*(volatile uint32_t *)(gov_dom[d].b + 0x920) = row;
+				gov_dom[d].cur = row;
+			}
+		}
+		absolutetime_to_nanoseconds(now - last_log, &log_ns);
+		if (logs < 60 && log_ns > 5 * NSEC_PER_SEC) {
+			last_log = now;
+			logs++;
+			printf("SWEET GOV: load %u/%u/%u -> %u/%u/%u MHz%s%s\n", load[0] / 10, load[1] / 10, load[2] / 10,
+			    gov_dom[0].khz[gov_dom[0].cur] / 1000, gov_dom[1].khz[gov_dom[1].cur] / 1000,
+			    gov_dom[2].khz[gov_dom[2].cur] / 1000, boost ? " boost" : "", off ? " screen-off" : "");
+		}
+	}
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET */
 
-- 
2.53.0

