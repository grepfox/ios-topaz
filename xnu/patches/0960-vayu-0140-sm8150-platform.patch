+	 * topaz gauge sits on SM6225 QUP I2C).
+	 */
+	int real = sweet_soc_vayu() ? 0 : 1;
+	if (!sweet_soc_vayu()) {
+		(void)PE_parse_boot_argn("sweetbattery", &real, sizeof(real));
+	}
 	fReal = real == 1 && sweet_i2c1_init() == 0;
 	/* Publish a complete source BEFORE registerService wakes powerd. */
 	poll();
diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
index 96c557b..3d3bb5c 100644
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -20,6 +20,7 @@
 
 extern "C" void sweet_secondary_entry(void);
 extern "C" boolean_t sweet_cpu_signal_is_enabled(unsigned int cpu);
+extern "C" int sweet_soc_vayu(void);       /* osfmk/arm64/sweet_early.c */
 
 class SweetCPU;
 static SweetCPU *sweet_cpus[MAX_CPUS];
@@ -73,16 +74,22 @@ SweetCPU::start(IOService *provider)
 	if (*(const uint32_t *)reg->getBytesNoCopy() != cpu->phys_id) {
 		return false;
 	}
-	/* topaz (SM6225): MPIDR Aff1 = cluster, Aff0 = core: 0x0-0x3 A53, 0x100-0x103 A73 */
-	if ((cpu->phys_id >> 8) > 1 || (cpu->phys_id & 0xff) > 3 ||
-	    topology->num_cpus > SWEET_SMP_MAX_CPUS) {
+	/*
+	 * topaz (SM6225): MPIDR Aff1 = cluster, Aff0 = core: 0x0-0x3 A53, 0x100-0x103 A73.
+	 * vayu (SM8150-AC, DynamIQ like sweet): Aff1 = core, 0x000-0x300 A55,
+	 * 0x400-0x600 A76 gold, 0x700 A76 prime.
+	 */
+	bool vayu = sweet_soc_vayu() != 0;
+	bool bad = vayu ? (cpu->phys_id > 0x700 || (cpu->phys_id & 0xff) != 0) :
+	    ((cpu->phys_id >> 8) > 1 || (cpu->phys_id & 0xff) > 3);
+	if (bad || topology->num_cpus > SWEET_SMP_MAX_CPUS) {
 		panic("SWEET CPU: invalid topology cpu=%u mpidr=0x%x count=%u",
 		    cpu->cpu_id, cpu->phys_id, topology->num_cpus);
 	}
 	if (!IOCPU::start(provider)) {
 		return false;
 	}
-	cpuName = OSSymbol::withCStringNoCopy("Kryo 260");
+	cpuName = OSSymbol::withCStringNoCopy(vayu ? "Kryo 485" : "Kryo 260");
 	if (cpuName == NULL) {
 		return false;
 	}
@@ -148,9 +155,11 @@ SweetCPU::startAll(void *arg __unused, wait_result_t result __unused)
 	 * topaz: the ADT lists only the A73 (gold) cores and the shim boots xnu
 	 * on gold CPU 0x100 (the silver cluster has no 16K granule).
 	 */
-	if (topology->boot_cpu->cpu_id != 0 || topology->boot_cpu->phys_id != 0x100) {
-		panic("SWEET CPU: expected boot MPIDR 0x100 and logical CPU 0, got 0x%x/%u",
-		    topology->boot_cpu->phys_id, topology->boot_cpu->cpu_id);
+	/* vayu: ABL boots on CPU 0 (A55, has the 16K granule), as on sweet */
+	uint32_t boot_mpidr = sweet_soc_vayu() ? 0 : 0x100;
+	if (topology->boot_cpu->cpu_id != 0 || topology->boot_cpu->phys_id != boot_mpidr) {
+		panic("SWEET CPU: expected boot MPIDR 0x%x and logical CPU 0, got 0x%x/%u",
+		    boot_mpidr, topology->boot_cpu->phys_id, topology->boot_cpu->cpu_id);
 	}
 	for (unsigned int i = 0; i < topology->num_cpus; i++) {
 		SweetCPU *cpu = __atomic_load_n(&sweet_cpus[i], __ATOMIC_ACQUIRE);
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 1d3ee17..27d1e46 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -94,6 +94,7 @@ class OSDictionary;
 static void sweet_bl_log(const char *who, OSDictionary *d);
 extern "C" void sweet_dcache_clean(vm_offset_t addr, unsigned length);  /* osfmk/arm/caches.c */
 extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern "C" int sweet_soc_vayu(void);       /* osfmk/arm64/sweet_early.c */
 
 #if defined(SWEET)
 #include <IOKit/IOService.h>
@@ -177,8 +178,9 @@ public:
 	uint8_t       fPending[SWEET_FB_SWAP_REC_SIZE];     /* latest swap, not yet shown */
 	bool          fDirty;
 	/* topaz direct MDP scanout (VIG0 / CTL0 from TopazGpuW disp.c) */
-	volatile uint32_t *fVig0;
+	volatile uint32_t *fVig0;       /* the SSPP that scans the boot framebuffer (VIG0 on topaz) */
 	volatile uint32_t *fCtl0;
+	uint32_t fPipeFlush;            /* that SSPP's CTL_FLUSH bit */
 	volatile uint32_t *fIntf1;      /* INTF_1 (DSI0) timing engine: refresh diagnostics */
 	uint32_t      fIntfFrames;
 	/* boot-arg sweetfb_lock=1: the vsync timer follows the panel (vsyncNext) */
@@ -352,11 +354,58 @@ AppleCLCD::start(IOService *provider)
 		IOLog("SWEET FB: no vsync timer\n");
 		return false;
 	}
-	fVig0 = (volatile uint32_t *)ml_io_map(0x05e05000, 0x1000);
-	fCtl0 = (volatile uint32_t *)ml_io_map(0x05e02000, 0x1000);
-	topaz_adreno_init();
-	setProperty("RedwoodWaitsForGPU", true);         /* present() waits for the GPU (eagl.c reads it) */
-	fDsi = (volatile uint8_t *)ml_io_map(0x05e94000, 0x1000);
+	/*
+	 * MDSS base: SM6225 0x5e00000, SM8150 0xae00000 (mdss_mdp "mdp_phys").
+	 * Both use the same block offsets: CTL0 +0x2000, VIG0 +0x5000, INTF_1
+	 * +0x6b800, DSI0 +0x94000.
+	 */
+	const bool vayu = sweet_soc_vayu() != 0;
+	const uint64_t mdss = vayu ? 0x0ae00000ull : 0x05e00000ull;
+	fPipeFlush = 1u << 0;           /* VIG0 */
+	fVig0 = (volatile uint32_t *)ml_io_map(mdss + 0x5000, 0x1000);
+	fCtl0 = (volatile uint32_t *)ml_io_map(mdss + 0x2000, 0x1000);
+	fDsi = (volatile uint8_t *)ml_io_map(mdss + 0x94000, 0x1000);
+	if (!vayu) {
+		/* topaz Adreno 610 (HackiOS-derived TopazAdreno); vayu's A640 is vayu_gpu.c */
+		topaz_adreno_init();
+		setProperty("RedwoodWaitsForGPU", true);         /* present() waits for the GPU (eagl.c reads it) */
+	}
+	if (vayu) {
+		/*
+		 * ABL's splash pipe is not known on vayu: take the SSPP whose SRC0
+		 * points into the boot framebuffer (sde-sspp-off and CTL_FLUSH bits
+		 * from the SM8150 DT / sde_hw_ctl), else keep VIG0.
+		 */
+		static const uint32_t off[8] = { 0x5000, 0x7000, 0x9000, 0xb000, 0x25000, 0x27000, 0x29000, 0x2b000 };
+		static const uint8_t bit[8] = { 0, 1, 2, 18, 11, 12, 24, 25 };
+		static const char *const name[8] = { "VIG0", "VIG1", "VIG2", "VIG3", "DMA0", "DMA1", "DMA2", "DMA3" };
+		uint64_t lo = fPhys, hi = fPhys + (uint64_t)fRowBytes * fHeight;
+		int chosen = -1;
+		for (int i = 0; i < 8; i++) {
+			volatile uint32_t *p = (volatile uint32_t *)ml_io_map(mdss + off[i], 0x1000);
+			if (p == NULL) {
+				continue;
+			}
+			uint32_t src = p[0x14 / 4];
+			IOLog("SWEET FB: vayu SSPP %s src %#x stride %#x format %#x\n", name[i], src,
+			    p[0x24 / 4], p[0x30 / 4]);
+			if (chosen < 0 && src >= lo && src < hi) {
+				chosen = i;
+				fVig0 = p;
+				fPipeFlush = 1u << bit[i];
+			}
+		}
+		IOLog("SWEET FB: vayu scanout pipe %s\n", chosen >= 0 ? name[chosen] : "VIG0 (no match)");
+		for (int i = 0; i < 6; i++) {
+			volatile uint32_t *c = (volatile uint32_t *)ml_io_map(mdss + 0x2000 + 0x200 * i, 0x1000);
+			/* CTL_TOP 0x014, CTL_INTF_ACTIVE 0x0f4 (active CTL, SDE 5.x) */
+			if (c != NULL && (c[0x0f4 / 4] & (1u << 1)) != 0) {
+				fCtl0 = c;
+				IOLog("SWEET FB: vayu CTL%d drives INTF_1 (top %#x)\n", i, c[0x014 / 4]);
+				break;
+			}
+		}
+	}
 	fDsiBuf = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
 	    kIODirectionInOut | kIOMemoryPhysicallyContiguous, page_size, 0x00000000fffff000ull);
 	fDsiBufPhys = fDsiBuf ? fDsiBuf->getPhysicalSegment(0, NULL, kIOMemoryMapperNone) : 0;
@@ -398,8 +447,8 @@ AppleCLCD::start(IOService *provider)
 		}
 	}
 	OSSafeReleaseNULL(accel);
-	/* dpu sm6115 catalog: intf_1 at mdp+0x6a800, mdp at 0x5e01000 */
-	fIntf1 = (volatile uint32_t *)ml_io_map(0x05e6b000, 0x1000);
+	/* dpu sm6115 catalog: intf_1 at mdp+0x6a800, mdp at 0x5e01000 (SM8150: sde-intf-off 0x6b800) */
+	fIntf1 = (volatile uint32_t *)ml_io_map(mdss + 0x6b000, 0x1000);
 	if (fIntf1 != NULL) {
 		volatile uint32_t *r = fIntf1 + 0x800 / 4;
 		r[0x0a8 / 4] = 0x3;     /* FRAME_LINE_COUNT_EN */
@@ -946,7 +995,7 @@ AppleCLCD::scanFrom(uint64_t pa, uint32_t stride)
 	fVig0[0x14 / 4] = (uint32_t)pa;
 	fVig0[0x24 / 4] = stride;
 	__asm__ volatile("dsb sy" ::: "memory");
-	fCtl0[0x18 / 4] = 0x20001;      /* flush VIG0 + CTL: latched at the next vsync */
+	fCtl0[0x18 / 4] = (1u << 17) | fPipeFlush;      /* flush pipe + CTL: latched at the next vsync */
 	__asm__ volatile("dsb sy" ::: "memory");
 	fScanPhys = pa;
 	fScanStride = stride;
