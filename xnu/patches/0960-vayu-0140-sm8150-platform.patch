-/* topaz (SM6225, sm6125.dtsi spmi_bus; PM6125 USID 0): PON 0x800, Vol+ = GPIO5 */
-#define KEYS_CORE_PA     0x01c40000u
-#define KEYS_OBS_PA      0x03e00000u
-#define KEYS_CNFG_PA     0x01c0a000u
+/*
+ * topaz (SM6225, sm6125.dtsi spmi_bus; PM6125 USID 0): PON 0x800, Vol+ = GPIO5.
+ * vayu (SM8150, spmi@c440000 core/obsrvr/cnfg; PM8150 USID 0): PON 0x800
+ * (KPDPWR bit 0, RESIN = Vol- bit 1), Vol+ = PM8150 GPIO6 (gpio-keys in the
+ * vayu dtbo, active low). Both are PMIC arbiter v5.
+ */
+struct keys_soc {
+	uint32_t core_pa, obs_pa, cnfg_pa;
+	uint16_t gpio_ppid;     /* SID 0, peripheral 0xc0 + GPIO - 1 */
+	uint16_t gpio_base;     /* 0xc000 + (GPIO - 1) * 0x100 */
+	const char *gpio_name;
+};
+static const struct keys_soc keys_topaz = { 0x01c40000u, 0x03e00000u, 0x01c0a000u, 0x0c4, 0xc400, "GPIO5" };
+static const struct keys_soc keys_vayu = { 0x0c440000u, 0x0e600000u, 0x0c40a000u, 0x0c5, 0xc500, "GPIO6" };
+static const struct keys_soc *keys_hw = &keys_topaz;
 #define KEYS_PON_RT      0x0810u
-#define KEYS_GPIO_RT     0xc410u
+#define KEYS_GPIO_RT     ((uint16_t)(keys_hw->gpio_base + 0x10u))
 #define KEYS_NO_APID     0xffffu
 
 static vm_offset_t keys_core, keys_obs, keys_cnfg;
@@ -114,8 +126,8 @@ keys_thread(void *arg, wait_result_t result)
 		for (int k = 0; k < 3; ++k) {
 			if ((k == 1 ? gok : pok) && now[k] != state[k]) {
 				state[k] = now[k];
-				printf("SWEET KEYS: key=%d down=%d pon=%#x gpio4:c110=%#x\n",
-				    k, state[k], pon, gpio);
+				printf("SWEET KEYS: key=%d down=%d pon=%#x %s=%#x\n",
+				    k, state[k], pon, keys_hw->gpio_name, gpio);
 				sweet_hid_key(k, state[k]);
 			}
 		}
@@ -137,9 +149,12 @@ sweet_keys_init(void)
 		printf("SWEET KEYS: disabled (sweetkeys=0)\n");
 		return;
 	}
-	keys_core = ml_io_map(KEYS_CORE_PA, 0x2000);
-	keys_cnfg = ml_io_map(KEYS_CNFG_PA, 0x1000);
-	keys_obs = ml_io_map(KEYS_OBS_PA, 0x10000);
+	if (sweet_soc_vayu()) {
+		keys_hw = &keys_vayu;
+	}
+	keys_core = ml_io_map(keys_hw->core_pa, 0x2000);
+	keys_cnfg = ml_io_map(keys_hw->cnfg_pa, 0x1000);
+	keys_obs = ml_io_map(keys_hw->obs_pa, 0x10000);
 	if (!keys_core || !keys_cnfg || !keys_obs) {
 		printf("SWEET KEYS: MMIO mapping failed\n");
 		return;
@@ -153,21 +168,22 @@ sweet_keys_init(void)
 		return;
 	}
 	keys_pon_apid = keys_find_apid(0x008, count);
-	keys_gpio_apid = keys_find_apid(0x0c4, count);
+	keys_gpio_apid = keys_find_apid(keys_hw->gpio_ppid, count);
 	uint8_t pon = 0, gpio = 0, mode = 0, en = 0, subtype = 0;
 	bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
 	bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
-	bool mok = keys_read(keys_gpio_apid, 0xc440, &mode);
-	bool eok = keys_read(keys_gpio_apid, 0xc446, &en);
-	bool sok = keys_read(keys_gpio_apid, 0xc405, &subtype);
-	printf("SWEET KEYS: arb=%#x apids=%u pon-apid=%u gpio4-apid=%u pon=%#x/%d gpio=%#x/%d mode=%#x/%d en=%#x/%d subtype=%#x/%d\n",
-	    keys_version, count, keys_pon_apid, keys_gpio_apid,
+	bool mok = keys_read(keys_gpio_apid, (uint16_t)(keys_hw->gpio_base + 0x40u), &mode);
+	bool eok = keys_read(keys_gpio_apid, (uint16_t)(keys_hw->gpio_base + 0x46u), &en);
+	bool sok = keys_read(keys_gpio_apid, (uint16_t)(keys_hw->gpio_base + 0x05u), &subtype);
+	printf("SWEET KEYS: arb=%#x apids=%u pon-apid=%u %s-apid=%u pon=%#x/%d gpio=%#x/%d mode=%#x/%d en=%#x/%d subtype=%#x/%d\n",
+	    keys_version, count, keys_pon_apid, keys_hw->gpio_name, keys_gpio_apid,
 	    pon, pok, gpio, gok, mode, mok, en, eok, subtype, sok);
 	/* GPIO configuration belongs to firmware. Diagnose, never repair it here. */
 	unsigned dir = subtype >= 0x10u && subtype <= 0x13u ?
 	    mode & 3u : (mode >> 4) & 7u;
 	if (!eok || !mok || !sok || !(en & 0x80u) || (dir != 0 && dir != 2)) {
-		printf("SWEET KEYS: GPIO5 not confirmed enabled as input; volume-up withheld, PMIC unchanged\n");
+		printf("SWEET KEYS: %s not confirmed enabled as input; volume-up withheld, PMIC unchanged\n",
+		    keys_hw->gpio_name);
 		keys_gpio_apid = KEYS_NO_APID;
 	}
 	if (!pok && !gok) {
