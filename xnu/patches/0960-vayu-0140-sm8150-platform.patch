+
+/*
+ * One kernel for topaz (SM6225) and vayu (Poco X3 Pro, SM8150-AC): the ADT
+ * root compatible says which phone this is (tools/mkadt.py --target).
+ * Only called once IOKit runs, never from the early console paths.
+ */
+int
+sweet_soc_vayu(void)
+{
+	static int cached = -1;
+	if (cached >= 0) {
+		return cached;
+	}
+	DTEntry root;
+	void const *prop = NULL;
+	unsigned int size = 0;
+	int vayu = 0;
+	if (SecureDTLookupEntry(NULL, "/", &root) == kSuccess &&
+	    SecureDTGetProperty(root, "compatible", &prop, &size) == kSuccess) {
+		const char *c = (const char *)prop;
+		static const char want[] = "xiaomi,vayu";
+		for (unsigned int i = 0; i < size;) {
+			size_t n = strnlen(c + i, size - i);
+			if (n == sizeof(want) - 1 && memcmp(c + i, want, n) == 0) {
+				vayu = 1;
+				break;
+			}
+			i += (unsigned int)n + 1;
+		}
+	}
+	cached = vayu;
+	return vayu;
+}
