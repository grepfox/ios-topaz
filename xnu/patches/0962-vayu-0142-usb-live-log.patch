From 0d7ffa8c333ef87e660296bb3c69d6b4d02ec73a Mon Sep 17 00:00:00 2001
From: grep <noreply@anthropic.com>
Date: Wed, 21 Oct 2026 12:02:34 +0200
Subject: [PATCH] vayu-0142: USB device and live log on vayu

sweet_usb_probe() now also runs on vayu (sweetusb=1 read-only probe by
default, sweetusb=2 starts the CDC-ECM gadget and the UDP live log). The
DWC3 at 0xa600000, its QSCRATCH and the GDSC (0xf004) match sweet;
the SM8150 clocks come from gcc-sm8150.c (cfg-noc 0xf078, aggre 0xf07c,
clkref usb3_sec 0x8c028). vayu's HS PHY is a SNPS femto, so the QUSB2
diagnostic read is skipped; the gadget relies on ABL's PHY setup as on
sweet.
---
 bsd/dev/sweet_ufs.c |  4 +++-
 bsd/dev/sweet_usb.c | 35 +++++++++++++++++++++++++++++++----
 2 files changed, 34 insertions(+), 5 deletions(-)

diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 143db60..aa78af9 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -53,6 +53,7 @@ extern void sweet_sample_start(void);
 extern void sweet_keys_init(void);
 extern void sweet_touch_init(void);
 extern void sweet_usb_probe(void);
+extern int sweet_soc_vayu(void);
 
 #define REG_CAP         0x00
 #define REG_IS          0x20
@@ -823,7 +824,8 @@ sweet_ufs_init(void)
 	(void)PE_parse_boot_argn("sweethw", &hw, sizeof(hw));
 	sweet_touch_init();
 	sweet_keys_init();
-	if (hw == 1) {
+	if (hw == 1 || sweet_soc_vayu()) {
+		/* vayu: same DWC3 (0xa600000) and QSCRATCH as sweet, SM8150 clocks */
 		sweet_usb_probe();
 	} else {
 		printf("SWEET UFS: USB skipped (topaz, sweethw=0)\n");
diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index 9c42e45..c1805a2 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -35,6 +35,7 @@
 #include <netinet/in.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern int sweet_soc_vayu(void);
 void sweet_usb_probe(void);
 static void sweet_usb_gadget_start(vm_offset_t dwc);
 extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
@@ -44,10 +45,12 @@ extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
 #define GCC_USB30_PRIM_GDSCR    0x0f004         /* bit 31: power on */
 #define CBCR_CLK_OFF            (1u << 31)
 
-static const struct {
+struct usb_clk {
 	const char *name;
 	uint32_t    off;
-} usb_cbcr[] = {
+};
+/* Same order on both SoCs: [0] master, [3] cfg-noc-axi gate the DWC3 reads, [5] the PHY's AHB */
+static const struct usb_clk usb_cbcr_sweet[] = {
 	{ "master", 0x0f010 },
 	{ "sleep", 0x0f014 },
 	{ "utmi", 0x0f018 },
@@ -56,6 +59,25 @@ static const struct {
 	{ "ahb2phy", 0x6a004 },
 	{ "clkref", 0x8c010 },
 };
+/*
+ * vayu (SM8150, YAAP kernel gcc-sm8150.c / sm8150-usb.dtsi): same GDSC
+ * 0xf004 and core clocks; the controller's ref clock is USB3_SEC_CLKREF
+ * (0x8c028) for both instances. No separate ahb2phy branch is listed here,
+ * so slot 5 repeats the master clock and the PHY is never read: vayu's HS
+ * PHY is a SNPS femto (phy-msm-snps-hs.c), not a QUSB2, and the gadget
+ * only relies on ABL having left it set up, as on sweet.
+ */
+static const struct usb_clk usb_cbcr_vayu[] = {
+	{ "master", 0x0f010 },
+	{ "sleep", 0x0f014 },
+	{ "utmi", 0x0f018 },
+	{ "cfg-noc-axi", 0x0f078 },
+	{ "aggre-axi", 0x0f07c },
+	{ "master", 0x0f010 },
+	{ "clkref", 0x8c028 },
+};
+#define USB_NCLK        (sizeof(usb_cbcr_sweet) / sizeof(usb_cbcr_sweet[0]))
+_Static_assert(sizeof(usb_cbcr_vayu) == sizeof(usb_cbcr_sweet), "clock tables differ");
 
 #define DWC3_PA                 0x0a600000
 #define DWC3_SIZE               0x0000d000
@@ -74,8 +96,10 @@ void
 sweet_usb_probe(void)
 {
 	int enabled = 1;
-	uint32_t gdscr, cbcr[sizeof(usb_cbcr) / sizeof(usb_cbcr[0])];
+	uint32_t gdscr, cbcr[USB_NCLK];
 	bool clocks_on = true;
+	const bool vayu = sweet_soc_vayu() != 0;
+	const struct usb_clk *usb_cbcr = vayu ? usb_cbcr_vayu : usb_cbcr_sweet;
 
 	/* sweetusb=0 off, 1 (default) report state only, 2 also start the USB device */
 	PE_parse_boot_argn("sweetusb", &enabled, sizeof(enabled));
@@ -89,7 +113,7 @@ sweet_usb_probe(void)
 	}
 	gdscr = usb_rd(gcc, GCC_USB30_PRIM_GDSCR);
 	printf("SWEET USB: GDSC usb30_prim 0x%08x (%s)\n", gdscr, (gdscr & (1u << 31)) ? "on" : "off");
-	for (unsigned i = 0; i < sizeof(usb_cbcr) / sizeof(usb_cbcr[0]); i++) {
+	for (unsigned i = 0; i < USB_NCLK; i++) {
 		cbcr[i] = usb_rd(gcc, usb_cbcr[i].off);
 		printf("SWEET USB: clk %-12s CBCR 0x%08x (%s)\n", usb_cbcr[i].name, cbcr[i],
 		    (cbcr[i] & CBCR_CLK_OFF) ? "off" : "on");
@@ -116,6 +140,9 @@ sweet_usb_probe(void)
 	if (enabled >= 2) {
 		sweet_usb_gadget_start(dwc);
 	}
+	if (vayu) {
+		return;         /* SNPS femto PHY: no QUSB2 registers to report */
+	}
 	if (cbcr[5] & CBCR_CLK_OFF) {
 		printf("SWEET USB: ahb2phy clock off; QUSB2 PHY not read\n");
 		return;
-- 
2.53.0

