From 9937f6cdd94c1b5cf87911b0b78eca1361a57776 Mon Sep 17 00:00:00 2001
From: grep <noreply@anthropic.com>
Date: Wed, 21 Oct 2026 16:21:52 +0200
Subject: [PATCH] vayu-0147: sample pid 1 always, first sample at 45 s; log the
 shim's DTB /memory list

With xnu at 0xc0000000 the boot stops inside load_init_program before
/sbin/launchd; pid 1 is not named launchd yet, so the sampler (with the
0145 kernel backtrace) skipped it. The boot-args IOLog line was cut
before sweetmem=, so print it alone.
---
 bsd/dev/sweet_sample.c                   | 6 ++++--
 iokit/Kernel/arm/SweetPlatformExpert.cpp | 7 +++++++
 2 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
index b40eccd..4b5bf38 100644
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -51,7 +51,8 @@ sweet_sample_proc(proc_t p, __unused void *arg)
 {
 	char name[32];
 	proc_name(proc_pid(p), name, sizeof(name));
-	if (sweet_sample_wanted(name)) {
+	/* pid 1 always: before its exec succeeds it is not called launchd yet */
+	if (proc_pid(p) == 1 || sweet_sample_wanted(name)) {
 		task_t task = proc_task(p);
 		if (task != TASK_NULL) {
 			sweet_sample_task(name, proc_pid(p), task);
@@ -70,7 +71,8 @@ sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
 	if (sweet_sample_names[0] == '-') {
 		return;
 	}
-	(void)tsleep(&chan, PZERO, "sweetsmp", 90 * hz);
+	/* first sample earlier (45 s): the init stalls are before any GUI */
+	(void)tsleep(&chan, PZERO, "sweetsmp", 45 * hz);
 	for (int i = 0; i < 40; i++) {
 		printf("SMP --- sample %d\n", i);
 		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
diff --git a/iokit/Kernel/arm/SweetPlatformExpert.cpp b/iokit/Kernel/arm/SweetPlatformExpert.cpp
index 248bb6a..ead4e1d 100644
--- a/iokit/Kernel/arm/SweetPlatformExpert.cpp
+++ b/iokit/Kernel/arm/SweetPlatformExpert.cpp
@@ -32,6 +32,13 @@ SweetPlatformExpert::start(IOService *provider)
 	IOLog("SWEET: starting device-tree platform expert\n");
 	/* vayu: the shim appends ABL's /memory as sweetmem=BASE+SIZE,... */
 	IOLog("SWEET: boot-args %s\n", PE_boot_args());
+	{
+		/* IOLog cuts long lines: the shim's RAM list on its own line */
+		static char mem[256];
+		if (PE_parse_boot_argn("sweetmem", mem, sizeof(mem))) {
+			IOLog("SWEET: DTB /memory %s\n", mem);
+		}
+	}
 	IOLog("SWEET: max_mem 0x%llx (%llu MiB), mem_size 0x%lx\n", max_mem, max_mem >> 20, (unsigned long)mem_size);
 	if (!IODTPlatformExpert::start(provider)) {
 		return false;
-- 
