From f3825aae962cc3208e0dd66e2eb81ec67fd6d0bd Mon Sep 17 00:00:00 2001
From: grep <noreply@anthropic.com>
Date: Wed, 21 Oct 2026 18:48:25 +0200
Subject: [PATCH] vayu-0149: SCTLR_EL1.SPAN=1 and PSTATE.PAN clear on
 PAN-capable cores

0148 caught pid 1 spinning in fleh_synchronous -> sleh_synchronous ->
arm_fast_fault from load_init_program_at_path+0x5c, and earlier dyld
inside the mach_vm_allocate trap: kernel stores to user memory fault
forever. The kernel is built without PAN (0081, for topaz's ARMv8.0
cores) and copies with plain loads/stores, but SCTLR_EL1.SPAN was 0, so
on vayu's ARMv8.2 A55/A76 every exception entry to EL1 set PSTATE.PAN.
Set SPAN (RES1 on ARMv8.0, so topaz is unchanged) and clear PAN at CPU
start when ID_AA64MMFR1_EL1.PAN says the core has it.
---
 osfmk/arm64/proc_reg.h | 16 +++++++++++++++-
 osfmk/arm64/start.s    | 10 ++++++++++
 2 files changed, 25 insertions(+), 1 deletion(-)

diff --git a/osfmk/arm64/proc_reg.h b/osfmk/arm64/proc_reg.h
index e01c124..6d4d39b 100644
--- a/osfmk/arm64/proc_reg.h
+++ b/osfmk/arm64/proc_reg.h
@@ -651,11 +651,25 @@
 #define SCTLR_JOP_KEYS_DEFAULT  0
 #endif
 
+/*
+ * SWEET/topaz kernels are built without PAN (0081) and copy to and from user
+ * memory with plain loads/stores. On PAN-capable cores (vayu: Cortex-A55/A76,
+ * ARMv8.2) SPAN=0 makes every exception entry to EL1 set PSTATE.PAN, and each
+ * kernel access to a user page then faults forever (load_init_program_at_path
+ * and the mach_vm_allocate copyout looped in arm_fast_fault). SPAN=1 leaves
+ * PAN alone; on ARMv8.0 (topaz) bit 23 is RES1 anyway.
+ */
+#if __ARM_PAN_AVAILABLE__
+#define SCTLR_SPAN_DEFAULT      0
+#else
+#define SCTLR_SPAN_DEFAULT      SCTLR_PAN_UNCHANGED
+#endif
+
 #define SCTLR_EL1_DEFAULT \
 	(SCTLR_RESERVED | SCTLR_UCI_ENABLED | SCTLR_nTWE_WFE_ENABLED | SCTLR_DZE_ENABLED | \
 	 SCTLR_I_ENABLED | SCTLR_SED_DISABLED | SCTLR_CP15BEN_ENABLED |                    \
 	 SCTLR_SA0_ENABLED | SCTLR_SA_ENABLED | SCTLR_C_ENABLED | SCTLR_M_ENABLED |        \
-	 SCTLR_CSEH_DEFAULT | SCTLR_DSSBS_DEFAULT |                                        \
+	 SCTLR_CSEH_DEFAULT | SCTLR_DSSBS_DEFAULT | SCTLR_SPAN_DEFAULT |                   \
 	 SCTLR_ROP_KEYS_DEFAULT | SCTLR_JOP_KEYS_DEFAULT)
 
 /*
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 9fd1cb9..f3397ba 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -863,6 +863,16 @@ common_start:
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
+#if defined(SWEET) && !__ARM_PAN_AVAILABLE__
+	/* PAN-capable core (ID_AA64MMFR1_EL1.PAN != 0): start with PSTATE.PAN clear */
+	mrs		x0, ID_AA64MMFR1_EL1
+	ubfx	x0, x0, #20, #4
+	cbz		x0, 1f
+	.long	0xd500409f		/* msr PAN, #0 (undefined on ARMv8.0) */
+	isb		sy
+1:
+#endif
+
 #if !VMAPPLE && !defined(SWEET)
 	MOV64   x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1
-- 
2.53.0

