diff --git a/bsd/dev/vayu_touch.c b/bsd/dev/vayu_touch.c
new file mode 100644
index 0000000..20e29fd
--- /dev/null
+++ b/bsd/dev/vayu_touch.c
@@ -0,0 +1,748 @@
+/*
+ * vayu (Poco X3 Pro, SM8150-AC) touch: Novatek NT36672C (TDDI, flashless)
+ * on QUPv3 SE17 SPI (0xc80000), reset GPIO12, IRQ GPIO122.
+ *
+ * Port of the protocol parts of the vayu Linux driver
+ * (drivers/input/touchscreen/nt36672c: nt36xxx.c, nt36xxx_fw_update.c,
+ * nt36xxx_mem_map.h): chip id check, host download of the firmware with
+ * hardware CRC, then 6-byte point records from the event buffer.
+ *
+ * The IC has no flash: its firmware (j20s_novatek_ts_fw01.bin for the
+ * Tianma panel, fw02 for CSOT) is passed in the ADT by tools/mkadt.py
+ * --touch-fw (/vayu-touch fw01/fw02); the shim adds vayupanel=36/42 from
+ * ABL's msm_drm.dsi_display0. Reports are read by polling every 8 ms (the
+ * Linux driver uses a falling-edge IRQ, which a level poll could miss).
+ *
+ * The SPI master is driven in GENI FIFO mode, polled, like the topaz I2C
+ * touch driver; register layout from Linux spi-geni-qcom.c / qcom-geni-se.
+ * Boot-args: sweettouch=0 off, vayutouchdiag=1 log every frame.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <mach/mach_time.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void vayu_touch_init(void);
+
+/* GCC (gcc-sm8150.c): QUPv3 wrap2 S0 (= SE17) branch, its RCG, wrap2 AHB votes */
+#define VT_GCC_PA        0x00100000u
+#define VT_GCC_SIZE      0x00060000u
+#define VT_GCC_VOTE      0x52014u        /* BIT1 wrap2 s_ahb, BIT2 m_ahb, BIT4 wrap2 s0 */
+#define VT_GCC_VOTE_BITS 0x16u
+#define VT_GCC_S0_CBCR   0x1e144u
+#define VT_GCC_S0_RCG    0x1e148u        /* CMD; CFG +4 */
+
+/* TLMM 0x3000000: NORTH tile +0x900000, SOUTH +0xd00000 (pinctrl-sm8150.c) */
+#define VT_TLMM_NORTH    0x03900000u
+#define VT_TLMM_SOUTH    0x03d00000u
+#define VT_PIN_RESET     12u             /* NORTH */
+#define VT_PIN_IRQ       122u            /* SOUTH */
+#define VT_PIN_SPI0      55u             /* 55..58 SOUTH, function qup17 = mux 1 */
+#define VT_GPIO_CFG(n)   ((uint32_t)(n) * 0x1000u)
+#define VT_GPIO_IO(n)    (VT_GPIO_CFG(n) + 4u)
+
+/* GENI SE17 */
+#define VT_SE_PA         0x00c80000u
+#define SE_GENI_CLK_CTRL 0x020u
+#define SE_GENI_OUTPUT   0x024u
+#define SE_GENI_CGC      0x028u
+#define SE_STATUS        0x040u
+#define SE_MCLK          0x048u
+#define SE_FW            0x068u
+#define SE_CLK_SEL       0x07cu
+#define SE_SPI_CPHA      0x224u
+#define SE_SPI_LOOPBACK  0x22cu
+#define SE_SPI_CPOL      0x230u
+#define SE_SPI_DEMUX_INV 0x24cu
+#define SE_SPI_DEMUX_SEL 0x250u
+#define SE_BYTE_GRAN     0x254u
+#define SE_DMA_MODE      0x258u
+#define SE_SPI_TRANS_CFG 0x25cu
+#define SE_TX_PACK0      0x260u
+#define SE_TX_PACK1      0x264u
+#define SE_SPI_WORD_LEN  0x268u
+#define SE_SPI_TX_LEN    0x26cu
+#define SE_SPI_RX_LEN    0x270u
+#define SE_SPI_PREPOST   0x274u
+#define SE_SPI_DELAYS    0x278u
+#define SE_RX_PACK0      0x284u
+#define SE_RX_PACK1      0x288u
+#define SE_M_CMD         0x600u
+#define SE_M_CTRL        0x604u
+#define SE_M_IRQ         0x610u
+#define SE_M_IRQ_EN      0x614u
+#define SE_M_IRQ_CLR     0x618u
+#define SE_S_IRQ_EN      0x644u
+#define SE_S_IRQ_CLR     0x648u
+#define SE_TX_FIFO       0x700u
+#define SE_RX_FIFO       0x780u
+#define SE_TX_STATUS     0x800u
+#define SE_RX_STATUS     0x804u
+#define SE_TX_WM         0x80cu
+#define SE_RX_WM         0x810u
+#define SE_RX_RFR        0x814u
+#define SE_GSI_EVENT     0xe18u
+#define SE_IRQ_ROUTE     0xe1cu
+#define SE_HW_TX         0xe24u
+#define SE_HW_RX         0xe28u
+#define SE_DMA_GENERAL   0xe30u
+#define SE_PACK0         0x0007f8feu     /* 8-bit words, MSB first, as Linux */
+#define SE_PACK1         0x000ffefeu
+#define M_CMD_DONE       (1u << 0)
+#define M_ERRORS         (0x3eu | (1u << 9) | (1u << 10) | (1u << 12))
+#define SPI_TX_ONLY      1u
+#define SPI_FULL_DUPLEX  3u
+
+/* Novatek (nt36xxx.h / mem_map NT36672A family, vayu dtbo values) */
+#define NVT_SWRST_N8     0x3F0FEu        /* novatek,swrst-n8-addr */
+#define NVT_SPI_RD_FAST  0x3F310u        /* novatek,spi-rd-fast-addr */
+#define NVT_ENG_RST      0x7FFF80u
+#define NVT_EVENT_BUF    0x21C00u
+#define NVT_BOOT_RDY     0x3F10Du
+#define NVT_ILM_LEN      0x3F118u
+#define NVT_DLM_LEN      0x3F130u
+#define NVT_ILM_DES      0x3F128u
+#define NVT_DLM_DES      0x3F12Cu
+#define NVT_G_ILM_CSUM   0x3F100u
+#define NVT_G_DLM_CSUM   0x3F104u
+#define NVT_BLD_CRC_EN   0x3F30Eu
+#define NVT_BLD_CRC_FLAG 0x3F133u
+#define EV_HOST_CMD      0x50u
+#define EV_RESET_DONE    0x60u
+#define EV_FWINFO        0x78u
+#define RESET_INIT       0xA0u
+#define RESET_MAX        0xAFu
+#define NVT_XFER         (63u * 1024u)
+#define NVT_POINT_LEN    65u
+#define NVT_FINGERS      10u
+#define NVT_PARTS        32u
+
+static struct {
+	vm_offset_t gcc, north, south, se;
+	unsigned tx_depth, rx_depth;
+	bool started, dead;
+	int diag;
+	uint32_t active;
+	int x[NVT_FINGERS], y[NVT_FINGERS];
+	uint64_t frames, downs;
+} vt;
+
+static int vt_sleep_chan;
+static uint8_t vt_tx[NVT_XFER + 8], vt_rx[NVT_XFER + 8];
+
+static uint32_t
+vt_rd(vm_offset_t b, uint32_t o)
+{
+	uint32_t v = *(volatile uint32_t *)(b + o);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+vt_wr(vm_offset_t b, uint32_t o, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(b + o) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static void
+vt_sleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&vt_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static vm_offset_t
+vt_tile(unsigned pin)
+{
+	return pin == VT_PIN_RESET ? vt.north : vt.south;
+}
+
+/* pull: 0 none, 1 down, 3 up; drive field = mA / 2 - 1 */
+static void
+vt_gpio(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out, bool high)
+{
+	vm_offset_t t = vt_tile(pin);
+	if (out) {
+		vt_wr(t, VT_GPIO_IO(pin), (vt_rd(t, VT_GPIO_IO(pin)) & ~2u) | (high ? 2u : 0u));
+	}
+	uint32_t cfg = vt_rd(t, VT_GPIO_CFG(pin)) & ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	vt_wr(t, VT_GPIO_CFG(pin), cfg);
+}
+
+static bool
+vt_clocks(void)
+{
+	vt_wr(vt.gcc, VT_GCC_VOTE, vt_rd(vt.gcc, VT_GCC_VOTE) | VT_GCC_VOTE_BITS);
+	/* XO (parent 0), divider 1, no M/N: 19.2 MHz into the SE */
+	vt_wr(vt.gcc, VT_GCC_S0_RCG + 4u, 1u);
+	vt_wr(vt.gcc, VT_GCC_S0_RCG, vt_rd(vt.gcc, VT_GCC_S0_RCG) | 1u);
+	for (unsigned i = 0; i < 5000 && (vt_rd(vt.gcc, VT_GCC_S0_RCG) & 1u); i++) {
+		delay(1);
+	}
+	for (unsigned i = 0; i < 5000 && (vt_rd(vt.gcc, VT_GCC_S0_CBCR) & (1u << 31)); i++) {
+		delay(1);
+	}
+	printf("VAYU TOUCH: gcc vote %#x rcg %#x cfg %#x cbcr %#x\n", vt_rd(vt.gcc, VT_GCC_VOTE),
+	    vt_rd(vt.gcc, VT_GCC_S0_RCG), vt_rd(vt.gcc, VT_GCC_S0_RCG + 4u), vt_rd(vt.gcc, VT_GCC_S0_CBCR));
+	return !(vt_rd(vt.gcc, VT_GCC_S0_CBCR) & (1u << 31));
+}
+
+static bool
+vt_se_init(void)
+{
+	uint32_t fw = vt_rd(vt.se, SE_FW), tx = vt_rd(vt.se, SE_HW_TX), rx = vt_rd(vt.se, SE_HW_RX);
+	vt.tx_depth = (tx >> 16) & 0x3fu;
+	vt.rx_depth = (rx >> 16) & 0x3fu;
+	printf("VAYU TOUCH: se17 fw %#x proto %u status %#x tx %#x rx %#x\n",
+	    fw, (fw >> 8) & 0xffu, vt_rd(vt.se, SE_STATUS), tx, rx);
+	if (((fw >> 8) & 0xffu) != 1u || vt.tx_depth < 2 || vt.rx_depth < 2 ||
+	    ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u) {
+		printf("VAYU TOUCH: SE17 has no SPI firmware or 32-bit FIFOs; stopping\n");
+		return false;
+	}
+	vt_wr(vt.se, SE_GSI_EVENT, 0);
+	vt_wr(vt.se, SE_IRQ_ROUTE, 0);
+	vt_wr(vt.se, SE_S_IRQ_EN, 0);
+	vt_wr(vt.se, SE_M_IRQ_CLR, 0xffffffffu);
+	vt_wr(vt.se, SE_S_IRQ_CLR, 0xffffffffu);
+	vt_wr(vt.se, SE_DMA_MODE, 0);
+	vt_wr(vt.se, SE_GENI_CGC, vt_rd(vt.se, SE_GENI_CGC) | 0x7fu);
+	vt_wr(vt.se, SE_DMA_GENERAL, vt_rd(vt.se, SE_DMA_GENERAL) | 0x0fu);
+	vt_wr(vt.se, SE_GENI_OUTPUT, 0x7f);
+	vt_wr(vt.se, SE_GENI_CLK_CTRL, 1);
+	/* 19.2 MHz / 4 = 4.8 MHz SCLK (the Linux driver runs at 10 MHz) */
+	vt_wr(vt.se, SE_CLK_SEL, 0);
+	vt_wr(vt.se, SE_MCLK, (4u << 4) | 1u);
+	/* SPI mode 0, CS0, 8-bit words, no delays */
+	vt_wr(vt.se, SE_SPI_LOOPBACK, 0);
+	vt_wr(vt.se, SE_SPI_CPHA, 0);
+	vt_wr(vt.se, SE_SPI_CPOL, 0);
+	vt_wr(vt.se, SE_SPI_DEMUX_INV, 0);
+	vt_wr(vt.se, SE_SPI_DEMUX_SEL, 0);
+	vt_wr(vt.se, SE_SPI_TRANS_CFG, 0);
+	vt_wr(vt.se, SE_SPI_WORD_LEN, 8u - 4u);
+	vt_wr(vt.se, SE_SPI_PREPOST, 0);
+	vt_wr(vt.se, SE_SPI_DELAYS, 0);
+	vt_wr(vt.se, SE_BYTE_GRAN, 0);
+	vt_wr(vt.se, SE_TX_PACK0, SE_PACK0);
+	vt_wr(vt.se, SE_TX_PACK1, SE_PACK1);
+	vt_wr(vt.se, SE_RX_PACK0, SE_PACK0);
+	vt_wr(vt.se, SE_RX_PACK1, SE_PACK1);
+	vt_wr(vt.se, SE_TX_WM, 0);
+	vt_wr(vt.se, SE_RX_WM, 0);
+	vt_wr(vt.se, SE_RX_RFR, vt.rx_depth - 1u);
+	vt_wr(vt.se, SE_M_IRQ_EN, M_CMD_DONE | M_ERRORS);
+	/* drain anything left over */
+	for (unsigned i = 0; i < 64 && (vt_rd(vt.se, SE_RX_STATUS) & 0x1ffffffu); i++) {
+		(void)vt_rd(vt.se, SE_RX_FIFO);
+	}
+	return true;
+}
+
+static void
+vt_cancel(void)
+{
+	vt_wr(vt.se, SE_M_CTRL, 4);     /* M_GENI_CMD_CANCEL */
+	for (unsigned i = 0; i < 1000 && !(vt_rd(vt.se, SE_M_IRQ) & (1u << 4)); i++) {
+		delay(1);
+	}
+	if (vt_rd(vt.se, SE_STATUS) & 1u) {
+		vt_wr(vt.se, SE_M_CTRL, 2);     /* M_GENI_CMD_ABORT */
+		for (unsigned i = 0; i < 1000 && !(vt_rd(vt.se, SE_M_IRQ) & (1u << 5)); i++) {
+			delay(1);
+		}
+	}
+	for (unsigned i = 0; i < 64 && (vt_rd(vt.se, SE_RX_STATUS) & 0x1ffffffu); i++) {
+		(void)vt_rd(vt.se, SE_RX_FIFO);
+	}
+	vt_wr(vt.se, SE_M_IRQ_CLR, 0xffffffffu);
+}
+
+/* One SPI command: len bytes out of tx; with rx, full duplex into rx. */
+static int
+vt_spi(const uint8_t *tx, uint8_t *rx, unsigned len)
+{
+	if (vt.dead || len == 0 || len > sizeof(vt_tx)) {
+		return EIO;
+	}
+	for (unsigned i = 0; i < 5000 && (vt_rd(vt.se, SE_STATUS) & 1u); i++) {
+		delay(1);
+	}
+	if (vt_rd(vt.se, SE_STATUS) & 1u) {
+		vt.dead = true;
+		printf("VAYU TOUCH: SE17 busy; stopping\n");
+		return EBUSY;
+	}
+	vt_wr(vt.se, SE_M_IRQ_CLR, 0xffffffffu);
+	vt_wr(vt.se, SE_SPI_TX_LEN, len);
+	vt_wr(vt.se, SE_SPI_RX_LEN, rx ? len : 0);
+	vt_wr(vt.se, SE_M_CMD, (rx ? SPI_FULL_DUPLEX : SPI_TX_ONLY) << 27);
+
+	unsigned sent = 0, got = 0;
+	uint64_t now = mach_absolute_time(), end;
+	nanoseconds_to_absolutetime(500 * NSEC_PER_MSEC, &end);
+	end += now;
+	while (mach_absolute_time() < end) {
+		uint32_t irq = vt_rd(vt.se, SE_M_IRQ);
+		if (irq & M_ERRORS) {
+			printf("VAYU TOUCH: spi error irq %#x len %u sent %u got %u\n", irq, len, sent, got);
+			vt_cancel();
+			return EIO;
+		}
+		/* keep the TX FIFO fed */
+		while (sent < len && (vt_rd(vt.se, SE_TX_STATUS) & 0xfffffffu) < vt.tx_depth) {
+			uint32_t w = 0;
+			for (unsigned j = 0; j < 4 && sent < len; j++) {
+				w |= (uint32_t)tx[sent++] << (8u * j);
+			}
+			vt_wr(vt.se, SE_TX_FIFO, w);
+		}
+		if (rx) {
+			uint32_t n = vt_rd(vt.se, SE_RX_STATUS) & 0x1ffffffu;
+			while (n--) {
+				uint32_t w = vt_rd(vt.se, SE_RX_FIFO);
+				for (unsigned j = 0; j < 4 && got < len; j++) {
+					rx[got++] = (uint8_t)(w >> (8u * j));
+				}
+			}
+		}
+		if (irq & M_CMD_DONE) {
+			if (rx) {
+				uint32_t n = vt_rd(vt.se, SE_RX_STATUS) & 0x1ffffffu;
+				while (n--) {
+					uint32_t w = vt_rd(vt.se, SE_RX_FIFO);
+					for (unsigned j = 0; j < 4 && got < len; j++) {
+						rx[got++] = (uint8_t)(w >> (8u * j));
+					}
+				}
+			}
+			vt_wr(vt.se, SE_M_IRQ_CLR, irq);
+			if (sent == len && (!rx || got == len)) {
+				return 0;
+			}
+			printf("VAYU TOUCH: spi short len %u sent %u got %u\n", len, sent, got);
+			return EIO;
+		}
+	}
+	printf("VAYU TOUCH: spi timeout len %u sent %u got %u irq %#x status %#x\n",
+	    len, sent, got, vt_rd(vt.se, SE_M_IRQ), vt_rd(vt.se, SE_STATUS));
+	vt_cancel();
+	return ETIMEDOUT;
+}
+
+/* CTP_SPI_WRITE: buf[0] = offset in page; bit 7 set marks a write */
+static int
+nvt_write(const uint8_t *buf, unsigned len)
+{
+	memcpy(vt_tx, buf, len);
+	vt_tx[0] |= 0x80u;
+	return vt_spi(vt_tx, NULL, len);
+}
+
+/* CTP_SPI_READ: buf[0] = offset; buf[1..len-1] <- data (after one dummy byte) */
+static int
+nvt_read(uint8_t *buf, unsigned len)
+{
+	memset(vt_tx, 0, len + 1);
+	vt_tx[0] = buf[0] & 0x7fu;
+	int err = vt_spi(vt_tx, vt_rx, len + 1);
+	if (err == 0) {
+		memcpy(buf + 1, vt_rx + 2, len - 1);
+	}
+	return err;
+}
+
+static int
+nvt_set_page(uint32_t addr)
+{
+	uint8_t b[3] = { 0xFF, (uint8_t)(addr >> 15), (uint8_t)(addr >> 7) };
+	return nvt_write(b, 3);
+}
+
+static int
+nvt_write_addr(uint32_t addr, uint8_t v)
+{
+	int err = nvt_set_page(addr);
+	uint8_t b[2] = { (uint8_t)(addr & 0x7f), v };
+	return err ? err : nvt_write(b, 2);
+}
+
+static void
+nvt_bootloader_reset(void)
+{
+	(void)nvt_write_addr(NVT_SWRST_N8, 0x69);
+	delay(5000);
+	(void)nvt_write_addr(NVT_SPI_RD_FAST, 0x00);
+}
+
+static int
+nvt_chip_id(void)
+{
+	for (int retry = 0; retry < 5; retry++) {
+		nvt_bootloader_reset();
+		(void)nvt_set_page(0x1F600);
+		uint8_t b[8] = { 0x4E };
+		int err = nvt_read(b, 7);
+		printf("VAYU TOUCH: chip id %02x %02x %02x %02x %02x %02x (err %d)\n",
+		    b[1], b[2], b[3], b[4], b[5], b[6], err);
+		/* NT36672A memory map family (trim table: xx ff ff 72/82 66 03) */
+		if (err == 0 && (b[4] == 0x72 || b[4] == 0x82) && b[5] == 0x66 && b[6] == 0x03) {
+			return 0;
+		}
+		vt_sleep(10);
+	}
+	return ENODEV;
+}
+
+static uint32_t
+le32(const uint8_t *p)
+{
+	return p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+struct nvt_part {
+	uint32_t bin, sram, size, crc;
+};
+static struct nvt_part parts[NVT_PARTS];
+static unsigned nparts;
+
+/* nvt_bin_header_parser, hw_crc = 1 */
+static int
+nvt_parse(const uint8_t *fw, uint32_t fwsize)
+{
+	uint32_t end = le32(fw), info = 0, ovly = 0;
+	for (uint32_t pos = 0x30; pos < end; pos += 0x10) {
+		info++;
+	}
+	if ((fw[0x28] & 0x10) != 0) {
+		ovly = fw[0x28] & 0x0f;
+	}
+	nparts = 2 + info + ovly;
+	if (nparts > NVT_PARTS) {
+		return EINVAL;
+	}
+	for (unsigned i = 0; i < nparts; i++) {
+		struct nvt_part *p = &parts[i];
+		uint32_t pos;
+		if (i < 2) {
+			p->bin = le32(&fw[i * 12]);
+			p->sram = le32(&fw[4 + i * 12]);
+			p->size = le32(&fw[8 + i * 12]);
+			p->crc = le32(&fw[0x18 + i * 4]);
+		} else {
+			pos = (i < 2 + info) ? 0x30 + 0x10 * (i - 2) : parts[1].bin + 0x10 * (i - 2 - info);
+			if (pos + 16 > fwsize) {
+				return EINVAL;
+			}
+			p->sram = le32(&fw[pos]);
+			p->size = le32(&fw[pos + 4]);
+			p->bin = le32(&fw[pos + 8]);
+			p->crc = le32(&fw[pos + 12]);
+		}
+		if (p->bin + p->size > fwsize) {
+			printf("VAYU TOUCH: fw part %u out of range (%#x+%#x > %#x)\n", i, p->bin, p->size, fwsize);
+			return EINVAL;
+		}
+	}
+	printf("VAYU TOUCH: fw %u bytes, %u partitions (info %u, overlay %u), ILM %#x+%#x DLM %#x+%#x\n",
+	    fwsize, nparts, info, ovly, parts[0].sram, parts[0].size, parts[1].sram, parts[1].size);
+	return 0;
+}
+
+/* nvt_write_firmware / nvt_write_sram: size + 1 bytes per partition, 63 KiB chunks */
+static int
+nvt_write_fw(const uint8_t *fw, uint32_t fwsize)
+{
+	for (unsigned i = 0; i < nparts; i++) {
+		uint32_t sram = parts[i].sram, bin = parts[i].bin, size = parts[i].size;
+		if (size == 0) {
+			continue;
+		}
+		size += 1;
+		while (size) {
+			uint32_t len = size < NVT_XFER ? size : NVT_XFER;
+			if (bin + len > fwsize) {
+				len = fwsize - bin;     /* the Linux driver reads one byte past a final partition */
+			}
+			int err = nvt_set_page(sram);
+			if (err) {
+				return err;
+			}
+			vt_tx[0] = (uint8_t)((sram & 0x7f) | 0x80u);
+			memcpy(vt_tx + 1, fw + bin, len);
+			err = vt_spi(vt_tx, NULL, len + 1);
+			if (err) {
+				return err;
+			}
+			if (size <= NVT_XFER) {
+				break;
+			}
+			sram += NVT_XFER;
+			bin += NVT_XFER;
+			size -= NVT_XFER;
+		}
+	}
+	return 0;
+}
+
+static void
+nvt_crc_bank(uint32_t des, uint32_t sram, uint32_t len_addr, uint32_t size, uint32_t gsum, uint32_t crc)
+{
+	uint8_t b[5];
+	(void)nvt_set_page(des);
+	b[0] = des & 0x7f; b[1] = (uint8_t)sram; b[2] = (uint8_t)(sram >> 8); b[3] = (uint8_t)(sram >> 16);
+	(void)nvt_write(b, 4);
+	b[0] = len_addr & 0x7f; b[1] = (uint8_t)size; b[2] = (uint8_t)(size >> 8);
+	(void)nvt_write(b, 3);          /* hw_crc 1: 2-byte length */
+	b[0] = gsum & 0x7f; b[1] = (uint8_t)crc; b[2] = (uint8_t)(crc >> 8); b[3] = (uint8_t)(crc >> 16); b[4] = (uint8_t)(crc >> 24);
+	(void)nvt_write(b, 5);
+}
+
+static int
+nvt_reset_state(void)
+{
+	(void)nvt_set_page(NVT_EVENT_BUF | EV_RESET_DONE);
+	uint8_t b[8];
+	for (int retry = 0; retry <= 10; retry++) {
+		b[0] = EV_RESET_DONE;
+		b[1] = 0;
+		(void)nvt_read(b, 6);
+		if (b[1] >= RESET_INIT && b[1] <= RESET_MAX) {
+			printf("VAYU TOUCH: reset state %#x after %d tries\n", b[1], retry);
+			return 0;
+		}
+		vt_sleep(10);
+	}
+	printf("VAYU TOUCH: reset state %02x %02x %02x %02x %02x (no fw run)\n", b[1], b[2], b[3], b[4], b[5]);
+	return EIO;
+}
+
+/* nvt_download_firmware_hw_crc */
+static int
+nvt_download(const uint8_t *fw, uint32_t fwsize)
+{
+	int err = nvt_parse(fw, fwsize);
+	if (err) {
+		return err;
+	}
+	for (int retry = 0; retry < 3; retry++) {
+		uint64_t t0 = mach_absolute_time(), ns;
+		nvt_bootloader_reset();
+		err = nvt_write_fw(fw, fwsize);
+		if (err) {
+			printf("VAYU TOUCH: fw write failed %d\n", err);
+			continue;
+		}
+		nvt_crc_bank(NVT_ILM_DES, parts[0].sram, NVT_ILM_LEN, parts[0].size, NVT_G_ILM_CSUM, parts[0].crc);
+		nvt_crc_bank(NVT_DLM_DES, parts[1].sram, NVT_DLM_LEN, parts[1].size, NVT_G_DLM_CSUM, parts[1].crc);
+		/* nvt_bld_crc_enable: set bit 7 of BLD_CRC_EN */
+		uint8_t b[4] = { NVT_BLD_CRC_EN & 0x7f, 0xFF };
+		(void)nvt_set_page(NVT_BLD_CRC_EN);
+		(void)nvt_read(b, 2);
+		b[0] = NVT_BLD_CRC_EN & 0x7f;
+		b[1] |= 0x80u;
+		(void)nvt_write(b, 2);
+		/* nvt_fw_crc_enable: clear reset status, host cmd 0xAE */
+		(void)nvt_set_page(NVT_EVENT_BUF);
+		b[0] = EV_RESET_DONE; b[1] = 0;
+		(void)nvt_write(b, 2);
+		b[0] = EV_HOST_CMD; b[1] = 0xAE;
+		(void)nvt_write(b, 2);
+		/* nvt_boot_ready (hw_crc: no POR_CD) */
+		(void)nvt_write_addr(NVT_BOOT_RDY, 1);
+		delay(5000);
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		printf("VAYU TOUCH: firmware written in %llu ms (try %d)\n", ns / NSEC_PER_MSEC, retry);
+		if (nvt_reset_state() == 0) {
+			return 0;
+		}
+		(void)nvt_set_page(NVT_BLD_CRC_FLAG);
+		b[0] = NVT_BLD_CRC_FLAG & 0x7f; b[1] = 0;
+		(void)nvt_read(b, 2);
+		printf("VAYU TOUCH: BLD CRC flag %#x (done %u, ILM err %u, DLM err %u)\n",
+		    b[1], (b[1] >> 2) & 1u, b[1] & 1u, (b[1] >> 1) & 1u);
+		err = EIO;
+	}
+	return err;
+}
+
+static void
+vt_report(uint32_t mask, const int *x, const int *y)
+{
+	for (unsigned id = 0; id < NVT_FINGERS; id++) {
+		uint32_t bit = 1u << id;
+		if (mask & bit) {
+			if (!(vt.active & bit) || x[id] != vt.x[id] || y[id] != vt.y[id]) {
+				sweet_hid_touch((int)id, 1, x[id], y[id]);
+				if (!(vt.active & bit)) {
+					vt.downs++;
+				}
+			}
+			vt.x[id] = x[id];
+			vt.y[id] = y[id];
+		} else if (vt.active & bit) {
+			sweet_hid_touch((int)id, 0, vt.x[id], vt.y[id]);
+		}
+	}
+	vt.active = mask;
+}
+
+static const uint8_t *
+vt_firmware(uint32_t *size, const char **name)
+{
+	int panel = 0;
+	(void)PE_parse_boot_argn("vayupanel", &panel, sizeof(panel));
+	DTEntry e;
+	void const *p = NULL;
+	unsigned int sz = 0;
+	if (SecureDTLookupEntry(NULL, "/vayu-touch", &e) != kSuccess) {
+		printf("VAYU TOUCH: no /vayu-touch in the ADT (mkadt.py --touch-fw)\n");
+		return NULL;
+	}
+	/* nvt_cmds_panel_info: dsi_j20s_36_02_0a (Tianma) -> fw01, else fw02 */
+	*name = panel == 42 ? "fw02" : "fw01";
+	if (SecureDTGetProperty(e, *name, &p, &sz) != kSuccess || sz < 0x100) {
+		printf("VAYU TOUCH: ADT /vayu-touch has no %s\n", *name);
+		return NULL;
+	}
+	printf("VAYU TOUCH: panel %d -> %s (%u bytes)\n", panel, *name, sz);
+	*size = sz;
+	return (const uint8_t *)p;
+}
+
+static void
+vt_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint32_t fwsize = 0;
+	const char *fwname = "?";
+	const uint8_t *fw = vt_firmware(&fwsize, &fwname);
+	if (fw == NULL) {
+		return;
+	}
+	vt.gcc = ml_io_map(VT_GCC_PA, VT_GCC_SIZE);
+	vt.north = ml_io_map(VT_TLMM_NORTH, VT_GPIO_CFG(VT_PIN_RESET) + 0x1000u);
+	vt.south = ml_io_map(VT_TLMM_SOUTH, VT_GPIO_CFG(VT_PIN_IRQ) + 0x1000u);
+	vt.se = ml_io_map(VT_SE_PA, 0x4000);
+	if (!vt.gcc || !vt.north || !vt.south || !vt.se) {
+		printf("VAYU TOUCH: MMIO map failed\n");
+		return;
+	}
+	printf("VAYU TOUCH: reset gpio cfg %#x io %#x, irq gpio cfg %#x io %#x\n",
+	    vt_rd(vt.north, VT_GPIO_CFG(VT_PIN_RESET)), vt_rd(vt.north, VT_GPIO_IO(VT_PIN_RESET)),
+	    vt_rd(vt.south, VT_GPIO_CFG(VT_PIN_IRQ)), vt_rd(vt.south, VT_GPIO_IO(VT_PIN_IRQ)));
+	if (!vt_clocks()) {
+		printf("VAYU TOUCH: SE17 clock did not start; stopping\n");
+		return;
+	}
+	/* SPI pins 55-58 -> qup17 (mux 1), 6 mA, no pull; IRQ input; reset output */
+	for (unsigned pin = VT_PIN_SPI0; pin < VT_PIN_SPI0 + 4u; pin++) {
+		vt_gpio(pin, 1, 0, 2, false, false);
+	}
+	vt_gpio(VT_PIN_IRQ, 0, 1, 7, false, false);
+	if (!vt_se_init()) {
+		return;
+	}
+	/* nvt_ts_probe: eng reset before TP_RESX high, then 10 ms after POR */
+	(void)nvt_write_addr(NVT_ENG_RST, 0x5A);
+	delay(1000);
+	vt_gpio(VT_PIN_RESET, 0, 3, 7, true, true);
+	vt_sleep(10);
+	if (nvt_chip_id() != 0) {
+		printf("VAYU TOUCH: no NT36672A-family chip on SE17; stopping\n");
+		return;
+	}
+	if (nvt_download(fw, fwsize) != 0) {
+		printf("VAYU TOUCH: firmware %s did not start; stopping\n", fwname);
+		return;
+	}
+	/* fw info (nvt_get_fw_info) and park the page on the event buffer */
+	uint8_t info[18] = { EV_FWINFO };
+	(void)nvt_set_page(NVT_EVENT_BUF);
+	(void)nvt_read(info, 17);
+	printf("VAYU TOUCH: fw ver %#x (~%#x) x_num %u y_num %u abs %u x %u\n", info[1], info[2], info[3], info[4],
+	    (info[5] << 8) | info[6], (info[7] << 8) | info[8]);
+	(void)nvt_set_page(NVT_EVENT_BUF);
+
+	uint8_t pd[NVT_POINT_LEN + 2];
+	int x[NVT_FINGERS], y[NVT_FINGERS];
+	unsigned errs = 0;
+	for (;;) {
+		vt_sleep(8);
+		pd[0] = 0;
+		if (nvt_read(pd, NVT_POINT_LEN + 1) != 0) {
+			if ((errs++ % 100u) == 0) {
+				printf("VAYU TOUCH: point read failed (%u)\n", errs);
+			}
+			if (vt.dead) {
+				return;
+			}
+			continue;
+		}
+		vt.frames++;
+		uint32_t mask = 0;
+		for (unsigned i = 0; i < NVT_FINGERS; i++) {
+			unsigned pos = 1 + 6 * i;
+			unsigned id = pd[pos] >> 3;
+			unsigned st = pd[pos] & 0x07u;
+			if (id == 0 || id > NVT_FINGERS || (st != 1 && st != 2)) {
+				continue;
+			}
+			int px = (pd[pos + 1] << 4) | (pd[pos + 3] >> 4);
+			int py = (pd[pos + 2] << 4) | (pd[pos + 3] & 0x0f);
+			if (px >= 1080 || py >= 2400) {
+				continue;
+			}
+			x[id - 1] = px;
+			y[id - 1] = py;
+			mask |= 1u << (id - 1);
+		}
+		if (vt.diag && (mask || vt.active)) {
+			printf("VAYU TOUCH: frame %02x %02x %02x %02x %02x %02x mask %#x\n",
+			    pd[1], pd[2], pd[3], pd[4], pd[5], pd[6], mask);
+		}
+		if (mask != vt.active || mask) {
+			if (mask && !vt.active && vt.downs < 5) {
+				printf("VAYU TOUCH: down at %d,%d (frame %llu)\n",
+				    x[__builtin_ctz(mask)], y[__builtin_ctz(mask)], vt.frames);
+			}
+			vt_report(mask, x, y);
+		}
+	}
+}
+
+void
+vayu_touch_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (vt.started) {
+		return;
+	}
+	vt.started = true;
+	(void)PE_parse_boot_argn("sweettouch", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("vayutouchdiag", &vt.diag, sizeof(vt.diag));
+	if (!enabled) {
+		printf("VAYU TOUCH: disabled (sweettouch=0)\n");
+		return;
+	}
+	if (kernel_thread_start(vt_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("VAYU TOUCH: kernel_thread_start failed\n");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
