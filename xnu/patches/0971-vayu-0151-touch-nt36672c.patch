 	st.started = true;
 	if (sweet_soc_vayu()) {
 		/*
-		 * vayu: Novatek NT36672C on QUPv3 SE17 SPI (0xc80000), reset GPIO12,
-		 * IRQ GPIO122, not ported yet. This driver is the topaz FT5452 on
