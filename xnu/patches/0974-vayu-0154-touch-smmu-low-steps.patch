From d7b3d13d2cbb02a9e8a276fd36e56a95b21a0224 Mon Sep 17 00:00:00 2001
From: grep <noreply@anthropic.com>
Date: Wed, 21 Oct 2026 21:15:41 +0200
Subject: [PATCH] vayu-0154: touch: SMMU banks from CB8/SMR8 up, start after 25
 s, GPI step markers

0153 reset the phone (to recovery, no panic, nothing logged): the GPI
stream got the highest free SMMU context bank, which the hypervisor
likely keeps. Search upward from CB8/SMR8 (USB uses CB4/SMR4), wait for
the USB live log (vayutouchdelay=, default 25 s) and print each GPI
bring-up step with a 300 ms pause.
---
 bsd/dev/vayu_touch.c | 28 +++++++++++++++++++++++-----
 1 file changed, 23 insertions(+), 5 deletions(-)

diff --git a/bsd/dev/vayu_touch.c b/bsd/dev/vayu_touch.c
index 3f8c3a0..6656e28 100644
--- a/bsd/dev/vayu_touch.c
+++ b/bsd/dev/vayu_touch.c
@@ -432,9 +432,10 @@ vt_spi(const uint8_t *tx, uint8_t *rx, unsigned len)
 
 /*
  * Identity SMMU context for one stream on the apps MMU-500 (0x15000000), as
- * sweet_usb.c does for USB (stream 0x140). USB takes the lowest free
- * context bank and SMR slot; this takes the highest, so the two threads
- * cannot pick the same ones.
+ * sweet_usb.c does for USB (stream 0x140, lowest free from CB4/SMR0).
+ * This searches upward from CB8/SMR8 so the two cannot collide. 0153 took
+ * the highest free ones and the phone reset (no panic): the hypervisor
+ * keeps high banks for itself.
  */
 static bool
 vt_smmu_identity(uint32_t sid)
@@ -461,19 +462,21 @@ vt_smmu_identity(uint32_t sid)
 		}
 	}
 	if (slot == ~0u) {
-		for (uint32_t i = (nsmr < 128 ? nsmr : 128); i-- > 0;) {
+		for (uint32_t i = 8; i < nsmr && i < 128; i++) {
 			if ((vt_rd(s, 0x800 + 4 * i) >> 31) == 0) {
 				slot = i;
 				break;
 			}
 		}
 	}
-	for (uint32_t i = (ncb < 64 ? ncb : 64); i-- > 4;) {
+	for (uint32_t i = 8; i < ncb && i < 64; i++) {
 		if ((used & (1ull << i)) == 0) {
 			cb = i;
 			break;
 		}
 	}
+	printf("VAYU TOUCH: SMMU will use CB%u SMR%u for stream %#x\n", cb, slot, sid);
+	delay(300000);
 	if (slot == ~0u || cb == ~0u || (uint64_t)(npage + cb + 1) * psize > 0x00100000u) {
 		printf("VAYU TOUCH: SMMU no free SMR/CB (slot %u cb %u)\n", slot, cb);
 		return false;
@@ -556,9 +559,13 @@ vg_init(void)
 	}
 	vg.pa = ptoa_64(pn);
 	vg_sync(0, VD_SIZE);
+	printf("VAYU TOUCH: GPI step 1: dma %#llx, SMMU next\n", vg.pa);
+	delay(300000);
 	if (!vt_smmu_identity(VT_GPI_SID)) {
 		return false;
 	}
+	printf("VAYU TOUCH: GPI step 2: SE17 to GSI mode\n");
+	delay(300000);
 	/* SE17 to GSI mode (geni_se_select_gsi_mode) */
 	vt_wr(vt.se, SE_IRQ_EN_REG, 0);
 	vt_wr(vt.se, SE_M_IRQ_EN, 0);
@@ -569,6 +576,8 @@ vg_init(void)
 	vt_wr(vt.se, SE_DMA_RX_CLR, 0xffffffffu);
 	vt_wr(vt.se, SE_DMA_MODE, vt_rd(vt.se, SE_DMA_MODE) | 1u);
 	vt_wr(vt.se, SE_GSI_EVENT_EN, vt_rd(vt.se, SE_GSI_EVENT_EN) | 0xfu);
+	printf("VAYU TOUCH: GPI step 3: reading GPII%u state\n", VT_GPII);
+	delay(300000);
 	printf("VAYU TOUCH: GPI GPII%u states ev %u ch0 %u ch1 %u, dma %#llx; SE dma_mode %#x gsi_ev %#x\n",
 	    VT_GPII, vg_state(GPI_EV_CTX), vg_state(GPI_CH_CTX(0)), vg_state(GPI_CH_CTX(1)), vg.pa,
 	    vt_rd(vt.se, SE_DMA_MODE), vt_rd(vt.se, SE_GSI_EVENT_EN));
@@ -587,6 +596,8 @@ vg_init(void)
 		(void)vg_cmd(2, GPI_CMD_DEALLOC, 0);
 	}
 	/* event ring (gpi_alloc_ev_chan): allocate, program, hand all slots but one to the GPI */
+	printf("VAYU TOUCH: GPI step 4: event ring\n");
+	delay(300000);
 	if (!vg_cmd(2, GPI_CMD_ALLOC, 1)) {
 		return false;
 	}
@@ -620,6 +631,8 @@ vg_init(void)
 		vt_wr(vg.gpi, GPI_CH_SCR(k, 3), 0);
 		vt_wr(vg.gpi, GPI_CH_QOS(k), 1);
 	}
+	printf("VAYU TOUCH: GPI step 5: starting channels\n");
+	delay(300000);
 	for (unsigned k = 0; k < 2; k++) {
 		if (!vg_cmd(k, GPI_CMD_START, 2)) {
 			return false;
@@ -1010,6 +1023,11 @@ vt_thread(void *arg __unused, wait_result_t wr __unused)
 {
 	uint32_t fwsize = 0;
 	const char *fwname = "?";
+	int wait_s = 25;
+	/* bring-up: start after the USB live log is streaming (vayutouchdelay=s) */
+	(void)PE_parse_boot_argn("vayutouchdelay", &wait_s, sizeof(wait_s));
+	printf("VAYU TOUCH: starting in %d s\n", wait_s);
+	vt_sleep((unsigned)wait_s * 1000u);
 	const uint8_t *fw = vt_firmware(0, &fwsize, &fwname);
 	if (fw == NULL) {
 		return;
-- 
2.53.0

