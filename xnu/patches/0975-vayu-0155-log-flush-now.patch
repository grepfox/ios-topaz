From ed4a46a3d6198f53aaa21265b7e7b53c804449da Mon Sep 17 00:00:00 2001
From: grep <noreply@anthropic.com>
Date: Wed, 21 Oct 2026 21:28:40 +0200
Subject: [PATCH] vayu-0155: sweet_log_flush_now(); touch step markers go to
 flash before each step

The 0154 boot also reset the phone and the user's live log stays empty,
so the recovery pull only had the previous boot. Add a synchronous flush
of the persistent console log and call it at every touch/GPI step.
---
 bsd/dev/sweet_ufs.c  | 24 ++++++++++++++++++++++++
 bsd/dev/vayu_touch.c | 16 ++++++++++------
 2 files changed, 34 insertions(+), 6 deletions(-)

diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index aa78af9..ae1cdcb 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -852,7 +852,9 @@ sweet_ufs_init(void)
 
 static char sweet_log_ring[SWEET_LOG_SIZE];
 static uint64_t _Atomic sweet_log_total;
+static uint64_t _Atomic sweet_log_flushed;      /* what is on flash */
 static int sweet_log_chan;
+static int sweet_log_running;
 static uint32_t sweet_log_secs = SWEET_LOG_SECS;
 
 /* Called for all console output, any context: never blocks. */
@@ -953,6 +955,27 @@ sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
 			return;
 		}
 		flushed = total;
+		os_atomic_store(&sweet_log_flushed, flushed, relaxed);
+		wakeup(&sweet_log_flushed);
+	}
+}
+
+/*
+ * Write the console log to flash now and wait (up to 2 s) until it is
+ * there: bring-up markers before a step that may reset the phone (vayu
+ * touch), so a recovery pull shows the last one.
+ */
+void sweet_log_flush_now(void);
+void
+sweet_log_flush_now(void)
+{
+	if (!sweet_log_running) {
+		return;
+	}
+	uint64_t want = os_atomic_load(&sweet_log_total, relaxed);
+	wakeup(&sweet_log_chan);
+	for (int i = 0; i < 40 && os_atomic_load(&sweet_log_flushed, relaxed) < want; i++) {
+		(void)tsleep(&sweet_log_flushed, PZERO, "sweetlogw", hz / 20 + 1);
 	}
 }
 
@@ -971,6 +994,7 @@ sweet_log_start(void)
 		sweet_log_secs = SWEET_LOG_SECS;
 	}
 	if (kernel_thread_start(sweet_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		sweet_log_running = 1;
 		thread_deallocate(thread);
 	}
 }
diff --git a/bsd/dev/vayu_touch.c b/bsd/dev/vayu_touch.c
index 6656e28..b7ad782 100644
--- a/bsd/dev/vayu_touch.c
+++ b/bsd/dev/vayu_touch.c
@@ -40,6 +40,7 @@
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern void sweet_log_flush_now(void);   /* bsd/dev/sweet_ufs.c */
 extern void sweet_hid_touch(int finger, int down, int x, int y);
 void vayu_touch_init(void);
 
@@ -327,6 +328,7 @@ vt_se_init(void)
 	vt_wr(vt.se, SE_M_IRQ_EN, M_CMD_DONE | M_ERRORS);
 	if (gsi_only) {
 		printf("VAYU TOUCH: SE17 FIFO interface disabled by its firmware: GPI DMA mode\n");
+		sweet_log_flush_now();
 		return vg_init();
 	}
 	/* drain anything left over */
@@ -476,7 +478,7 @@ vt_smmu_identity(uint32_t sid)
 		}
 	}
 	printf("VAYU TOUCH: SMMU will use CB%u SMR%u for stream %#x\n", cb, slot, sid);
-	delay(300000);
+	sweet_log_flush_now();
 	if (slot == ~0u || cb == ~0u || (uint64_t)(npage + cb + 1) * psize > 0x00100000u) {
 		printf("VAYU TOUCH: SMMU no free SMR/CB (slot %u cb %u)\n", slot, cb);
 		return false;
@@ -560,12 +562,12 @@ vg_init(void)
 	vg.pa = ptoa_64(pn);
 	vg_sync(0, VD_SIZE);
 	printf("VAYU TOUCH: GPI step 1: dma %#llx, SMMU next\n", vg.pa);
-	delay(300000);
+	sweet_log_flush_now();
 	if (!vt_smmu_identity(VT_GPI_SID)) {
 		return false;
 	}
 	printf("VAYU TOUCH: GPI step 2: SE17 to GSI mode\n");
-	delay(300000);
+	sweet_log_flush_now();
 	/* SE17 to GSI mode (geni_se_select_gsi_mode) */
 	vt_wr(vt.se, SE_IRQ_EN_REG, 0);
 	vt_wr(vt.se, SE_M_IRQ_EN, 0);
@@ -577,7 +579,7 @@ vg_init(void)
 	vt_wr(vt.se, SE_DMA_MODE, vt_rd(vt.se, SE_DMA_MODE) | 1u);
 	vt_wr(vt.se, SE_GSI_EVENT_EN, vt_rd(vt.se, SE_GSI_EVENT_EN) | 0xfu);
 	printf("VAYU TOUCH: GPI step 3: reading GPII%u state\n", VT_GPII);
-	delay(300000);
+	sweet_log_flush_now();
 	printf("VAYU TOUCH: GPI GPII%u states ev %u ch0 %u ch1 %u, dma %#llx; SE dma_mode %#x gsi_ev %#x\n",
 	    VT_GPII, vg_state(GPI_EV_CTX), vg_state(GPI_CH_CTX(0)), vg_state(GPI_CH_CTX(1)), vg.pa,
 	    vt_rd(vt.se, SE_DMA_MODE), vt_rd(vt.se, SE_GSI_EVENT_EN));
@@ -597,7 +599,7 @@ vg_init(void)
 	}
 	/* event ring (gpi_alloc_ev_chan): allocate, program, hand all slots but one to the GPI */
 	printf("VAYU TOUCH: GPI step 4: event ring\n");
-	delay(300000);
+	sweet_log_flush_now();
 	if (!vg_cmd(2, GPI_CMD_ALLOC, 1)) {
 		return false;
 	}
@@ -632,7 +634,7 @@ vg_init(void)
 		vt_wr(vg.gpi, GPI_CH_QOS(k), 1);
 	}
 	printf("VAYU TOUCH: GPI step 5: starting channels\n");
-	delay(300000);
+	sweet_log_flush_now();
 	for (unsigned k = 0; k < 2; k++) {
 		if (!vg_cmd(k, GPI_CMD_START, 2)) {
 			return false;
@@ -1028,6 +1030,8 @@ vt_thread(void *arg __unused, wait_result_t wr __unused)
 	(void)PE_parse_boot_argn("vayutouchdelay", &wait_s, sizeof(wait_s));
 	printf("VAYU TOUCH: starting in %d s\n", wait_s);
 	vt_sleep((unsigned)wait_s * 1000u);
+	printf("VAYU TOUCH: start\n");
+	sweet_log_flush_now();
 	const uint8_t *fw = vt_firmware(0, &fwsize, &fwname);
 	if (fw == NULL) {
 		return;
-- 
