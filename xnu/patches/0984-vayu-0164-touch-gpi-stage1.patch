From d12c69b6139f11b5d6d8702a01d31db4d233eda1 Mon Sep 17 00:00:00 2001
From: grep <grepfox@tutamail.com>
Date: Thu, 22 Oct 2026 10:06:04 +0200
Subject: [PATCH] vayu-0164: touch GPI stage-1 SMMU context mapping only the
 DMA buffer (Linux smmu-cfg 1); fault readback

---
 bsd/dev/vayu_touch.c | 73 +++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 69 insertions(+), 4 deletions(-)

diff --git a/bsd/dev/vayu_touch.c b/bsd/dev/vayu_touch.c
index 51f7fbf..3ca5298 100644
--- a/bsd/dev/vayu_touch.c
+++ b/bsd/dev/vayu_touch.c
@@ -180,7 +180,9 @@ void vayu_touch_init(void);
 #define VD_EVR           0x0400u         /* 64 events */
 #define VD_TXB           0x1000u
 #define VD_RXB           0x12000u
-#define VD_SIZE          0x24000u
+#define VD_PT_L1         0x24000u        /* SMMU stage-1 tables (mode 4) */
+#define VD_PT_L2         0x25000u
+#define VD_SIZE          0x28000u
 #define VD_RING_N        32u
 #define VD_EV_N          64u
 /* SE in GSI mode (qcom-geni-se.c geni_se_select_gsi_mode) */
@@ -450,6 +452,7 @@ vt_spi(const uint8_t *tx, uint8_t *rx, unsigned len)
  * keeps high banks for itself.
  */
 static vm_offset_t vg_smmu, vg_cbp;
+static void vg_sync(uint32_t off, uint32_t len);
 
 static bool
 vt_smmu_identity(uint32_t sid)
@@ -507,7 +510,15 @@ vt_smmu_identity(uint32_t sid)
 	 * context bank sweet_usb.c set up for USB stream 0x140 (CB4), which
 	 * demonstrably reaches DDR. 0 = own CB from 8 up (resets), 1 bypass, 2 fault.
 	 */
-	int mode = 3;
+	/*
+	 * 0163: sharing USB's identity CB4 also reset at EV ALLOCATE. Every
+	 * mode where the GPI reaches memory resets there, so the GPI likely
+	 * touches some address besides our rings. Mode 4 (default) is what
+	 * Linux does (qcom,smmu-cfg = 1): a real stage-1 context. Only the 2M
+	 * blocks holding our buffer are mapped (IOVA = PA); anything else is a
+	 * context fault (terminate, no stall, no IRQ) that we read back.
+	 */
+	int mode = 4;
 	(void)PE_parse_boot_argn("vayugpismmu", &mode, sizeof(mode));
 	printf("VAYU TOUCH: SMMU before: sGFSR %#x sCR0 %#x mode %d\n", vt_rd(s, 0x48), vt_rd(s, 0x0), mode);
 	if (mode == 3) {
@@ -536,6 +547,56 @@ vt_smmu_identity(uint32_t sid)
 		    vt_rd(s + psize, 4 * ucb), vt_rd(ucbp, 0x58));
 		return true;
 	}
+	if (mode == 4) {
+		uint64_t lo = vg.pa & ~0x1fffffull, hi = (vg.pa + VD_SIZE - 1) & ~0x1fffffull;
+		if ((lo >> 30) != (hi >> 30)) {
+			printf("VAYU TOUCH: SMMU dma buffer crosses 1G; no stage-1 table\n");
+			return false;
+		}
+		volatile uint64_t *l1 = (volatile uint64_t *)(vg.va + VD_PT_L1);
+		volatile uint64_t *l2 = (volatile uint64_t *)(vg.va + VD_PT_L2);
+		for (unsigned i = 0; i < 512; i++) {
+			l1[i] = 0;
+			l2[i] = 0;
+		}
+		l1[(lo >> 30) & 511] = (vg.pa + VD_PT_L2) | 3u;     /* table */
+		for (uint64_t b = lo; b <= hi; b += 0x200000ull) {
+			/* block, AttrIndx 0, AP RW any EL, inner shareable, AF */
+			l2[(b >> 21) & 511] = b | (1u << 10) | (3u << 8) | (1u << 6) | 1u;
+		}
+		vg_sync(VD_PT_L1, 0x2000);
+		vt_wr(cbp, 0x0, 0);                     /* SCTLR off while we build it */
+		vt_wr(cbp, 0x58, 0xffffffff);           /* FSR clear */
+		vt_wr(gr1, 0x800 + 4 * cb, 0x00000001); /* CBA2R VA64 */
+		vt_wr(gr1, 0x000 + 4 * cb, 0x0001f000); /* CBAR: S1 trans, S2 bypass */
+		vt_wr(cbp, 0x20, (uint32_t)(vg.pa + VD_PT_L1));
+		vt_wr(cbp, 0x24, (uint32_t)((vg.pa + VD_PT_L1) >> 32));
+		vt_wr(cbp, 0x28, 0);                    /* TTBR1 */
+		vt_wr(cbp, 0x2c, 0);
+		/* TCR: T0SZ 25 (39-bit), WB/WB inner shareable walks, 4K, EPD1 */
+		vt_wr(cbp, 0x30, 25u | (1u << 8) | (1u << 10) | (3u << 12) | (1u << 23));
+		vt_wr(cbp, 0x10, 2u);                   /* TCR2: 40-bit PA */
+		vt_wr(cbp, 0x38, 0xffu);                /* MAIR0 attr0 normal WB */
+		vt_wr(cbp, 0x3c, 0);
+		vt_wr(cbp, 0x618, 0);                   /* TLBIALL */
+		vt_wr(cbp, 0x7f0, 0);                   /* TLBSYNC */
+		for (unsigned n = 0; n < 100000 && (vt_rd(cbp, 0x7f4) & 1) != 0; n++) {
+			delay(1);
+		}
+		vt_wr(cbp, 0x0, 0x21);                  /* SCTLR: M, CFRE (abort), no stall, no IRQ */
+		vt_wr(s, 0xc00 + 4 * slot, cb);
+		vt_wr(s, 0x800 + 4 * slot, (1u << 31) | sid);
+		vt_wr(s, 0x70, 0);
+		for (unsigned n = 0; n < 100000 && (vt_rd(s, 0x74) & 1) != 0; n++) {
+			delay(1);
+		}
+		vg_smmu = s;
+		vg_cbp = cbp;
+		printf("VAYU TOUCH: SMMU stage-1 CB%u SMR%u: SMR %08x S2CR %08x SCTLR %08x CBAR %08x TCR %08x TTBR0 %08x%08x l2 %#llx..%#llx\n",
+		    cb, slot, vt_rd(s, 0x800 + 4 * slot), vt_rd(s, 0xc00 + 4 * slot), vt_rd(cbp, 0x0),
+		    vt_rd(gr1, 4 * cb), vt_rd(cbp, 0x30), vt_rd(cbp, 0x24), vt_rd(cbp, 0x20), lo, hi);
+		return true;
+	}
 	if (mode == 1 || mode == 2) {
 		vt_wr(s, 0xc00 + 4 * slot, mode == 1 ? 0x10000u : 0x20000u);
 		vt_wr(s, 0x800 + 4 * slot, (1u << 31) | sid);
@@ -776,8 +837,8 @@ vg_init(void)
 	sweet_log_flush_now();
 	vt_wr(vg.gpi, GPI_EV_DB, (uint32_t)(vg.pa + VD_EVR + 16u * vg.ev_wp));
 	delay(100);
-	printf("VAYU TOUCH: GPI step 4d: event ring ready (err %#x, gpii irq %#x)\n", vt_rd(vg.gpi, GPI_ERR_LOG),
-	    vt_rd(vg.gpi, 0x23118u + 0x4000u * VT_GPII));
+	printf("VAYU TOUCH: GPI step 4d: event ring ready (err %#x, gpii irq %#x, CB FSR %#x FAR %#x)\n", vt_rd(vg.gpi, GPI_ERR_LOG),
+	    vt_rd(vg.gpi, 0x23118u + 0x4000u * VT_GPII), vg_cbp ? vt_rd(vg_cbp, 0x58) : 0u, vg_cbp ? vt_rd(vg_cbp, 0x60) : 0u);
 	sweet_log_flush_now();
 	/* channels: 0 = TX (OUT), 1 = RX (IN), paired, protocol SPI (1), SE 0 */
 	for (unsigned k = 0; k < 2; k++) {
@@ -821,6 +882,10 @@ vg_dump(void)
 	    vt_rd(vt.se, 0x040), vt_rd(vt.se, 0x600), vt_rd(vt.se, 0x610), vt_rd(vt.se, 0x614),
 	    vt_rd(vt.se, 0x640), vt_rd(vt.se, 0x644), vt_rd(vt.se, 0xc40), vt_rd(vt.se, 0xd40),
 	    vt_rd(vt.se, SE_DMA_MODE), vt_rd(vt.se, SE_GSI_EVENT_EN));
+	if (vg_cbp) {
+		printf("VAYU TOUCH: SMMU CB FSR %#x FAR %08x%08x FSYNR0 %#x sGFSR %#x\n", vt_rd(vg_cbp, 0x58),
+		    vt_rd(vg_cbp, 0x64), vt_rd(vg_cbp, 0x60), vt_rd(vg_cbp, 0x68), vt_rd(vg_smmu, 0x48));
+	}
 	printf("VAYU TOUCH: GPII%u irq type %#x ch %#x ev %#x ieob %#x glob %#x gpii %#x\n", VT_GPII,
 	    vt_rd(vg.gpi, 0x23080u + b), vt_rd(vg.gpi, 0x23090u + b), vt_rd(vg.gpi, 0x23094u + b),
 	    vt_rd(vg.gpi, 0x230b0u + b), vt_rd(vg.gpi, 0x23100u + b), vt_rd(vg.gpi, 0x23118u + b));
-- 
2.53.0

