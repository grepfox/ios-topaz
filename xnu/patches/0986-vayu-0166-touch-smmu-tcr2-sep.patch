From 1bf97fd13038807a1638e4a32417e4e488d74e1e Mon Sep 17 00:00:00 2001
From: grep <grepfox@tutamail.com>
Date: Thu, 22 Oct 2026 11:17:49 +0200
Subject: [PATCH] vayu-0166: touch GPI SMMU TCR2 SEP_UPSTREAM + AS (bit 31
 IOVAs went to TTBR1)

---
 bsd/dev/vayu_touch.c | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/bsd/dev/vayu_touch.c b/bsd/dev/vayu_touch.c
index 7f5c7fe..74ca6a4 100644
--- a/bsd/dev/vayu_touch.c
+++ b/bsd/dev/vayu_touch.c
@@ -575,7 +575,12 @@ vt_smmu_identity(uint32_t sid)
 		vt_wr(cbp, 0x2c, 0);
 		/* TCR: T0SZ 25 (39-bit), WB/WB inner shareable walks, 4K, EPD1 */
 		vt_wr(cbp, 0x30, 25u | (1u << 8) | (1u << 10) | (3u << 12) | (1u << 23));
-		vt_wr(cbp, 0x10, 2u);                   /* TCR2: 40-bit PA */
+		/*
+		 * TCR2: 40-bit PA, 16-bit ASID, SEP_UPSTREAM (arm-smmu.c). 0165:
+		 * with SEP 0 bit 31 picked TTBR1 (EPD1), so every buffer address
+		 * (0xc4f9xxxx) took a translation fault; IOVA 0 walked TTBR0.
+		 */
+		vt_wr(cbp, 0x10, 2u | (1u << 4) | (7u << 15));
 		vt_wr(cbp, 0x38, 0xffu);                /* MAIR0 attr0 normal WB */
 		vt_wr(cbp, 0x3c, 0);
 		vt_wr(cbp, 0x618, 0);                   /* TLBIALL */
@@ -592,9 +597,9 @@ vt_smmu_identity(uint32_t sid)
 		}
 		vg_smmu = s;
 		vg_cbp = cbp;
-		printf("VAYU TOUCH: SMMU stage-1 CB%u SMR%u: SMR %08x S2CR %08x SCTLR %08x CBAR %08x TCR %08x TTBR0 %08x%08x l2 %#llx..%#llx\n",
+		printf("VAYU TOUCH: SMMU stage-1 CB%u SMR%u: SMR %08x S2CR %08x SCTLR %08x CBAR %08x TCR %08x TCR2 %08x TTBR0 %08x%08x l2 %#llx..%#llx\n",
 		    cb, slot, vt_rd(s, 0x800 + 4 * slot), vt_rd(s, 0xc00 + 4 * slot), vt_rd(cbp, 0x0),
-		    vt_rd(gr1, 4 * cb), vt_rd(cbp, 0x30), vt_rd(cbp, 0x24), vt_rd(cbp, 0x20), lo, hi);
+		    vt_rd(gr1, 4 * cb), vt_rd(cbp, 0x30), vt_rd(cbp, 0x10), vt_rd(cbp, 0x24), vt_rd(cbp, 0x20), lo, hi);
 		return true;
 	}
 	if (mode == 1 || mode == 2) {
-- 
2.53.0

