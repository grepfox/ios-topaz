From 333e9766aaea03ac047c25b7adf1145d0d9f786c Mon Sep 17 00:00:00 2001
From: grep <grepfox@tutamail.com>
Date: Thu, 22 Oct 2026 14:05:31 +0200
Subject: [PATCH] vayu-0173: battery log label PM8150B FG gen4

---
 iokit/Kernel/arm/SweetBattery.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/iokit/Kernel/arm/SweetBattery.cpp b/iokit/Kernel/arm/SweetBattery.cpp
index 66452dd..2b0ce23 100644
--- a/iokit/Kernel/arm/SweetBattery.cpp
+++ b/iokit/Kernel/arm/SweetBattery.cpp
@@ -163,7 +163,7 @@ SweetBattery::publish(unsigned percent, unsigned mv, int ma, bool external,
 	int mode = measured ? 1 : 0;
 	if (mode != fLastMode) {
 		IOLog("SWEET BATTERY: %s, %u%% %umV external=%d charging=%d\n",
-		    measured ? "PM6150 / estimated SOC" : "static fallback",
+		    measured ? (fVayu ? "PM8150B FG gen4" : "PM6150 / estimated SOC") : "static fallback",
 		    percent, mv, external, charging);
 		fLastMode = mode;
 	}
