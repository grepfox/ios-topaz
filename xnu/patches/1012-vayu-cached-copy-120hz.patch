diff --git a/iokit/Kernel/arm/TopazAdreno.cpp b/iokit/Kernel/arm/TopazAdreno.cpp
index 1cfadf4..db126a3 100644
--- a/iokit/Kernel/arm/TopazAdreno.cpp
+++ b/iokit/Kernel/arm/TopazAdreno.cpp
@@ -253,6 +253,55 @@ topaz_gpu_pool_md(uint64_t pa, uint64_t size)
 	           kIODirectionInOut | (kIOWriteCombineCache << kIOMemoryBufferCacheShift), TASK_NULL);
 }
 
+/*
+ * A cached kernel view of the whole pool, for reading what the GPU drew with the CPU (vayu's
+ * panel copy). The pool's own mappings are write-combined, and reading 11 MB of a frame from
+ * there took 8.3 ms (1011 log). Nothing is written through this view, so it holds no dirty
+ * lines: invalidate the range (topaz_gpu_pool_invalidate) after the GPU is done, then read.
+ * Made on first use; NULL if the pool is not set up or the mapping failed. vayupoolcache=0: off.
+ */
+#ifndef VM_WIMG_DEFAULT
+#define VM_WIMG_DEFAULT 0x2      /* osfmk/arm/memory_types.h: write-back cacheable */
+#endif
+extern "C" vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+extern "C" uint8_t *topaz_gpu_pool_cached(uint64_t pa, uint64_t size);
+uint8_t *
+topaz_gpu_pool_cached(uint64_t pa, uint64_t size)
+{
+	static vm_offset_t base;
+	static int state;               /* 0 untried, 1 mapped, -1 off */
+
+	if (state == 0) {
+		uint32_t on = 1;
+		(void)PE_parse_boot_argn("vayupoolcache", &on, sizeof(on));
+		state = -1;
+		if (on && gpu_pool_base != 0 && gpu_pool_size != 0) {
+			base = ml_io_map_unmappable((vm_offset_t)gpu_pool_base, (vm_size_t)gpu_pool_size, VM_WIMG_DEFAULT);
+			state = base != 0 ? 1 : -1;
+			IOLog("TopazGPU: cached view of the pool %s (%#llx + %llu MB)\n", base ? "made" : "NOT made",
+			    gpu_pool_base, gpu_pool_size >> 20);
+		}
+	}
+	if (state != 1 || pa < gpu_pool_base || pa + size > gpu_pool_base + gpu_pool_size) {
+		return NULL;
+	}
+	return (uint8_t *)(base + (pa - gpu_pool_base));
+}
+
+/* drop this view's lines of [va, va + size) (DC IVAC: they are never dirty) */
+extern "C" void topaz_gpu_pool_invalidate(const uint8_t *va, uint64_t size);
+void
+topaz_gpu_pool_invalidate(const uint8_t *va, uint64_t size)
+{
+	uintptr_t a = (uintptr_t)va & ~(uintptr_t)63, end = (uintptr_t)va + size;
+
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (; a < end; a += 64) {
+		__asm__ volatile ("dc ivac, %0" :: "r"(a) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
 /* boot-arg gpu_midmem=1: the ADT gives the kernel RAM below 4 GiB (mkadt.py --midmem), GPU memory is the kernel's */
 static uint32_t gpu_midmem;
 extern "C" bool topaz_gpu_midmem(void);
