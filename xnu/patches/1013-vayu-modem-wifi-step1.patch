+/*
+ * What Linux's PIL does on SM8150 before the TrustZone calls (subsys-pil-tz, peripheral-loader):
+ * tell the AOP the modem image is loading ("qcom,signal-aop"), and vote vdd_cx and vdd_mss to
+ * TURBO (qcom,vdd_cx-uV-uA / vdd_mss). With wifi=1, the WCN3998's rails as icnss votes them:
+ * vdd-cx-mx L1A 752 mV, vdd-1.8-xo L7A, vdd-1.3-rfa L2C, vdd-3.3-ch0 L11C 3104 mV.
+ */
+extern "C" int sweet_aop_send(const char *msg);                     /* bsd/dev/sweet_qmp.c */
+extern "C" int sweet_rpmh_arc_vote(const char *res, unsigned vlvl);  /* bsd/dev/sweet_rpmh.c */
+extern "C" int sweet_rpmh_ldo(const char *res, unsigned mv);
+
+static void
+vayu_power_up(void)
+{
+	int aop = sweet_aop_send("{class: image, res: load_state, name: modem, val: on}");
+	int cx = sweet_rpmh_arc_vote("cx.lvl", 384), mss = sweet_rpmh_arc_vote("mss.lvl", 384);
+	LOG("vayu: AOP load_state modem on: %d; vdd_cx TURBO %d, vdd_mss TURBO %d", aop, cx, mss);
+	if (wifi_enabled()) {
+		int a = sweet_rpmh_ldo("ldoa1", 752), b = sweet_rpmh_ldo("ldoa7", 1800);
+		int c = sweet_rpmh_ldo("ldoc2", 1304), d = sweet_rpmh_ldo("ldoc11", 3104);
+		LOG("vayu: WCN3998 rails L1A %d L7A %d L2C %d L11C %d", a, b, c, d);
+	}
+}
