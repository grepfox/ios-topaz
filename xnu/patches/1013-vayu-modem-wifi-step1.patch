+/*
+ * vayu modem/WLAN power (TopazModem vayu_power_up), ACTIVE set only.
+ * sweet_rpmh_arc_vote: an ARC rail ("cx.lvl", "mss.lvl") at the lowest of its levels that is at
+ * least vlvl (cmd-db aux: u16 voltage levels; the vote is that level's index, as Linux's
+ * rpmh-arc-regulator sends it). sweet_rpmh_ldo: one of the WCN3998's PMIC5 LDOs on, HPM, at mv,
+ * only from this list (DT icnss supplies and their ranges).
+ */
+int sweet_cmddb_aux(const char *res, void *buf, unsigned max);
+int sweet_rpmh_arc_vote(const char *res, unsigned vlvl);
+int sweet_rpmh_ldo(const char *res, unsigned mv);
+
+#define RH_ARC          3u
+
+int
+sweet_rpmh_arc_vote(const char *res, unsigned vlvl)
+{
+	uint16_t lv[16] = {0};
+	int len = sweet_cmddb_aux(res, lv, sizeof(lv));
+	unsigned n = len > 0 ? (unsigned)len / 2 : 0, idx = 0;
+
+	if (n == 0) {
+		printf("SWEET RPMH: %s: no level table (%d)\n", res, len);
+		return EINVAL;
+	}
+	while (idx + 1 < n && lv[idx + 1] != 0 && lv[idx] < vlvl) {
+		idx++;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (rh_poisoned) {
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, RH_ARC, &address);
+	}
+	if (!error) {
+		const uint32_t offsets[1] = {0};
+		const uint32_t values[1] = {idx};
+		error = rh_send(address, 1, offsets, values);
+	}
+	printf("SWEET RPMH: ARC %s level %u (vlvl %u, wanted %u): %d\n", res, idx, lv[idx], vlvl, error);
+out:
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+int
+sweet_rpmh_ldo(const char *res, unsigned mv)
+{
+	static const struct { const char *name; unsigned lo, hi; } ok[] = {
+		{ "ldoa1", 752, 800 },          /* vdd-cx-mx */
+		{ "ldoa7", 1704, 1904 },        /* vdd-1.8-xo */
+		{ "ldoc2", 1250, 1350 },        /* vdd-1.3-rfa */
+		{ "ldoc11", 2950, 3400 },       /* vdd-3.3-ch0 */
+	};
+	unsigned i;
+	for (i = 0; i < sizeof(ok) / sizeof(ok[0]); i++) {
+		if (res && strcmp(res, ok[i].name) == 0 && mv >= ok[i].lo && mv <= ok[i].hi) {
+			break;
+		}
+	}
+	if (i == sizeof(ok) / sizeof(ok[0])) {
+		printf("SWEET RPMH: %s %u mV not in the WLAN rail list\n", res ? res : "(null)", mv);
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (rh_poisoned) {
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, RH_VRM, &address);
+	}
+	if (!error) {
+		const uint32_t offsets[3] = {0, 8, 4};  /* voltage, mode (HPM 7), enable last */
+		const uint32_t values[3] = {mv, 7, 1};
+		error = rh_send(address, 3, offsets, values);
+	}
+	printf("SWEET RPMH: %s %u mV on: %d\n", res, mv, error);
+out:
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
