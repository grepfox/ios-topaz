index 0000000..4b32bb3
--- /dev/null
+++ b/bsd/dev/sweet_qmp.c
@@ -0,0 +1,201 @@
+/*
+ * vayu (SM8150): one message to the AOP over QMP, polled. Port of the Linux 4.14 msm_qmp.c state
+ * machine (YAAP kernel drivers/mailbox/msm_qmp.c) for qcom,qmp-aop@c300000: message RAM
+ * 0xc300000, doorbell bit 0 of the APCS IPC register 0x17c0000c. The AOP is the "ucore", we
+ * are the "mcore": we re-open the link as Linux does at boot, open the channel, write
+ * [length][text] into our mailbox and wait for the AOP to zero the length (taken).
+ *
+ * Used for "{class: image, res: load_state, name: modem, val: on}" before the modem's PAS
+ * boot (peripheral-loader.c pil_notify_aop, qcom,signal-aop). Thread context only.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+int sweet_aop_send(const char *msg);
+
+#define QMP_MSGRAM      0x0c300000u
+#define QMP_IRQ_REG     0x17c0000cu
+#define QMP_IRQ_MASK    0x1u
+#define QMP_MAGIC       0x4d41494cu     /* "MAIL" */
+#define LINK_DOWN       0xFFFF0000u
+#define LINK_UP         0x0000FFFFu
+#define CH_DISC         0xFFFF0000u
+#define CH_CONN         0x0000FFFFu
+#define QMP_MSG_LEN     96              /* peripheral-loader.c MAX_LEN */
+
+/* struct mbox_desc: magic, version, features, ucore{6 words}, mcore{6 words} */
+#define D_MAGIC         0x00
+#define U_LINK          0x0c
+#define U_LINK_ACK      0x10
+#define U_CH            0x14
+#define U_CH_ACK        0x18
+#define U_MBOX_SIZE     0x1c
+#define U_MBOX_OFF      0x20
+#define M_LINK          0x24
+#define M_LINK_ACK      0x28
+#define M_CH            0x2c
+#define M_CH_ACK        0x30
+#define M_MBOX_SIZE     0x34
+#define M_MBOX_OFF      0x38
+
+static volatile uint8_t *qmp_ram;
+static volatile uint32_t *qmp_irq;
+static bool qmp_open;
+static unsigned qmp_lock;
+
+static uint32_t
+q_rd(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(qmp_ram + off);
+	__asm__ volatile ("dmb osh" ::: "memory");
+	return v;
+}
+
+static void
+q_wr(uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dmb osh" ::: "memory");
+	*(volatile uint32_t *)(qmp_ram + off) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static void
+q_kick(void)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*qmp_irq = QMP_IRQ_MASK;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* acknowledge the AOP's channel state if it changed (Linux does it in every state) */
+static void
+q_ack_ucore_ch(void)
+{
+	uint32_t ch = q_rd(U_CH);
+	if (ch != q_rd(U_CH_ACK)) {
+		q_wr(U_CH_ACK, ch);
+		q_kick();
+	}
+}
+
+/* drop whatever the AOP put in its mailbox (replies are not needed here) */
+static void
+q_drain_ucore(void)
+{
+	uint32_t off = q_rd(U_MBOX_OFF);
+	if (off != 0 && off < 0x1000 && q_rd(off) != 0) {
+		q_wr(off, 0);
+		q_kick();
+	}
+}
+
+static int
+q_connect(void)
+{
+	if (q_rd(D_MAGIC) != QMP_MAGIC) {
+		printf("SWEET QMP: no AOP mailbox (magic %#x)\n", q_rd(D_MAGIC));
+		return ENODEV;
+	}
+	printf("SWEET QMP: AOP link %#x/%#x ch %#x/%#x mbox %#x+%#x; ours link %#x/%#x ch %#x/%#x mbox %#x+%#x\n",
+	    q_rd(U_LINK), q_rd(U_LINK_ACK), q_rd(U_CH), q_rd(U_CH_ACK), q_rd(U_MBOX_OFF), q_rd(U_MBOX_SIZE),
+	    q_rd(M_LINK), q_rd(M_LINK_ACK), q_rd(M_CH), q_rd(M_CH_ACK), q_rd(M_MBOX_OFF), q_rd(M_MBOX_SIZE));
+	if (q_rd(M_MBOX_SIZE) < QMP_MSG_LEN + 4 || q_rd(M_MBOX_OFF) == 0 || q_rd(M_MBOX_OFF) + q_rd(M_MBOX_SIZE) > 0x1000) {
+		printf("SWEET QMP: our mailbox is not described\n");
+		return ENODEV;
+	}
+	/* LINK_DISCONNECTED -> NEGOTIATION (init_mcore_state) */
+	uint32_t size = q_rd(M_MBOX_SIZE), off = q_rd(M_MBOX_OFF);
+	q_wr(U_LINK_ACK, q_rd(U_LINK));
+	q_wr(M_LINK, LINK_UP);
+	q_wr(M_LINK_ACK, LINK_DOWN);
+	q_wr(M_CH, CH_DISC);
+	q_wr(M_CH_ACK, CH_DISC);
+	q_wr(M_MBOX_SIZE, size);
+	q_wr(M_MBOX_OFF, off);
+	q_kick();
+	unsigned t;
+	for (t = 0; t < 1000 && !(q_rd(M_LINK_ACK) == LINK_UP && q_rd(M_LINK) == LINK_UP); t++) {
+		q_ack_ucore_ch();
+		delay(1000);
+	}
+	if (t == 1000) {
+		printf("SWEET QMP: link not acknowledged (ours %#x/%#x)\n", q_rd(M_LINK), q_rd(M_LINK_ACK));
+		return ETIMEDOUT;
+	}
+	/* LINK_CONNECTED -> LOCAL_CONNECTING -> CHANNEL_CONNECTED (qmp_startup) */
+	q_wr(M_CH, CH_CONN);
+	q_kick();
+	for (t = 0; t < 1000; t++) {
+		q_ack_ucore_ch();
+		if (q_rd(M_CH_ACK) == CH_CONN && q_rd(U_CH) == CH_CONN && q_rd(U_CH_ACK) == CH_CONN) {
+			break;
+		}
+		delay(1000);
+	}
+	printf("SWEET QMP: channel %s after %u ms (AOP ch %#x/%#x, ours %#x/%#x)\n", t < 1000 ? "open" : "NOT open", t,
+	    q_rd(U_CH), q_rd(U_CH_ACK), q_rd(M_CH), q_rd(M_CH_ACK));
+	return t < 1000 ? 0 : ETIMEDOUT;
+}
+
+int
+sweet_aop_send(const char *msg)
+{
+	int err = 0;
+	if (msg == NULL || strlen(msg) >= QMP_MSG_LEN) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&qmp_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	if (qmp_ram == NULL) {
+		qmp_ram = (volatile uint8_t *)ml_io_map(QMP_MSGRAM, 0x1000);
+		qmp_irq = (volatile uint32_t *)ml_io_map(QMP_IRQ_REG & ~0xfffu, 0x1000);
+		if (qmp_irq != NULL) {
+			qmp_irq = (volatile uint32_t *)((volatile uint8_t *)qmp_irq + (QMP_IRQ_REG & 0xfffu));
+		}
+	}
+	if (qmp_ram == NULL || qmp_irq == NULL) {
+		err = ENOMEM;
+		goto out;
+	}
+	if (!qmp_open) {
+		if ((err = q_connect()) != 0) {
+			goto out;
+		}
+		qmp_open = true;
+	}
+	uint32_t off = q_rd(M_MBOX_OFF);
+	unsigned t;
+	for (t = 0; t < 1000 && q_rd(off) != 0; t++) {      /* the previous message taken */
+		delay(1000);
+	}
+	if (t == 1000) {
+		err = EBUSY;
+		goto out;
+	}
+	uint32_t w[QMP_MSG_LEN / 4];
+	bzero(w, sizeof(w));
+	memcpy(w, msg, strlen(msg));
+	for (unsigned i = 0; i < QMP_MSG_LEN / 4; i++) {
+		q_wr(off + 4 + 4 * i, w[i]);
+	}
+	q_wr(off, QMP_MSG_LEN);
+	q_kick();
+	for (t = 0; t < 1000 && q_rd(off) != 0; t++) {
+		q_ack_ucore_ch();
+		q_drain_ucore();
+		delay(1000);
+	}
+	q_drain_ucore();
+	printf("SWEET QMP: \"%s\" %s after %u ms\n", msg, t < 1000 ? "taken" : "NOT taken", t);
+	err = t < 1000 ? 0 : ETIMEDOUT;
+out:
+	__atomic_store_n(&qmp_lock, 0, __ATOMIC_RELEASE);
+	return err;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
