+ */
+static void
+soc_select_vayu(void)
+{
+	g_modem_pool = 0xBB000000ull;
+	g_smem_pa = 0x86000000ull;
+	g_tcsr_mutex_pa = 0x01F40000ull;
+	g_apcs_pa = 0x17C00000ull;
+	g_apcs_ipc = 0xC;                       /* apcs: syscon@17c0000c */
+	g_carve_base = 0x8E000000u;
+	g_carve_size = 0x9600000u;
+	g_msa_base = 0x8BC00000u;               /* pil_wlan_fw_region (0x180000), MSA 0x100000 */
+	g_smmu_pa = 0x15000000ull;
+	g_smmu_size = 0x00100000u;
+	g_wlan_sid = 0x640;                     /* icnss iommus = <&apps_smmu 0x0640 0x1> */
+	g_wlan_mem = 0x18800000ull;
+	fw_files = fw_files_vayu;
+	fw_files_n = sizeof(fw_files_vayu) / sizeof(fw_files_vayu[0]);
+	fw_ext = fw_ext_vayu;
+	fw_all = fw_all_vayu;
+	fw_all_n = sizeof(fw_all_vayu) / sizeof(fw_all_vayu[0]);
+	strlcpy(fw_part, "modem", sizeof(fw_part));
