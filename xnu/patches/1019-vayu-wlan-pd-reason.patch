From 5e660757ba22c06195cf251ea4c5921ba9913c95 Mon Sep 17 00:00:00 2001
From: grep <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 10:12:30 +0200
Subject: [PATCH] vayu: log WLAN PD failure reason (PFR, SMEM 421), assign MSA
 regions once

---
 iokit/Kernel/arm/TopazModem.cpp | 53 +++++++++++++++++++++++++++++++--
 1 file changed, 51 insertions(+), 2 deletions(-)

diff --git a/iokit/Kernel/arm/TopazModem.cpp b/iokit/Kernel/arm/TopazModem.cpp
index df588e9..69e73c7 100644
--- a/iokit/Kernel/arm/TopazModem.cpp
+++ b/iokit/Kernel/arm/TopazModem.cpp
@@ -2805,8 +2805,24 @@ pdm_rx(uint32_t node, uint32_t port, uint16_t txn, uint16_t msg, const uint8_t *
 	uint16_t v;
 
 	qm_init(&m, txn, msg);
+	if (msg == 0x24) {                      /* SERVREG_LOC_PFR: a PD's failure reason */
+		static unsigned pfr_logged;
+		char svc[72], why[260];
+		qm_string(d, len, 1, svc, sizeof(svc));
+		qm_string(d, len, 2, why, sizeof(why));
+		for (char *c = why; *c; c++) {
+			if (*c < 0x20 || *c > 0x7e) {
+				*c = '.';
+			}
+		}
+		if (pfr_logged++ < 6) {
+			LOG("t=%u ms: pd-mapper: PFR \"%s\": %s", g_ms, svc, why[0] ? why : "(no reason)");
+		}
+	}
 	if (msg != 0x21) {                      /* PFR etc.: just say OK */
-		LOG("t=%u ms: pd-mapper: msg %x", g_ms, msg);
+		if (msg != 0x24) {
+			LOG("t=%u ms: pd-mapper: msg %x", g_ms, msg);
+		}
 		qm_result(&m, true);
 		qm_send(&m, PORT_PDM, node, port);
 		return;
@@ -3626,7 +3642,26 @@ w_on_msa_info(const uint8_t *d, uint32_t len)
 			LOG(" out of the MSA window, skipped");
 			continue;
 		}
-		(void)scm_assign(addr, size, vm, sec ? 2 : 3);
+		/*
+		 * Once given, the region stays the WLAN's: after a WLAN PD restart the same call
+		 * from HLOS fails (vayu 1018: ret -2 res 0xf on every restart). Assign once.
+		 */
+		static uint64_t done[4];
+		bool again = false;
+		for (unsigned k = 0; k < 4; k++) {
+			again |= done[k] == addr;
+		}
+		if (again) {
+			continue;
+		}
+		if (scm_assign(addr, size, vm, sec ? 2 : 3) == 0) {
+			for (unsigned k = 0; k < 4; k++) {
+				if (done[k] == 0) {
+					done[k] = addr;
+					break;
+				}
+			}
+		}
 	}
 }
 
@@ -3641,6 +3676,20 @@ wlfw_arrive(uint32_t node, uint32_t port)
 	if (w_arrivals++ != 0) {
 		/* the WLAN PD restarted (new server port): start the handshake again */
 		LOG("t=%u ms: WLFW back on port %x (restart %u, last step: %s): handshake again", g_ms, port, w_arrivals - 1, w_step);
+		if (w_arrivals <= 4) {                  /* the WLAN PD lives in the modem: its crash text */
+			uint32_t sz = 0;
+			const char *why = (const char *)smem_get(smem_partition(SMEM_GLOBAL_HOST, SMEM_GLOBAL_HOST), ITEM_MSS_CRASH, &sz);
+			char buf[160] = {};
+			if (why != NULL) {
+				memcpy(buf, why, MIN(sz, (uint32_t)sizeof(buf) - 1));
+				for (char *c = buf; *c; c++) {
+					if (*c < 0x20 || *c > 0x7e) {
+						*c = '.';
+					}
+				}
+			}
+			LOG("  SMEM %u (crash reason): %s", ITEM_MSS_CRASH, why != NULL ? buf : "(none)");
+		}
 		w_msa_ind = w_cap_done = w_bdf_started = w_fw_ready = w_mission = false;
 		w_board = 0xFF;
 		w_cap_tries = 0;
-- 
2.53.0

